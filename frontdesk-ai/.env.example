# Front Desk AI backend settings.
# Copy this file to ".env" for local runs, or paste each value into your host's
# "Variables" screen (Railway, Docker). Never commit the real .env file.

# ---------------------------------------------------------------- Voice (required for the live demo)
# Your xAI API key. Get it at https://console.x.ai (API keys). Needs prepaid credit.
# Without it the site still works: the demo shows "unavailable" and plays sample calls.
XAI_API_KEY=your_xai_api_key_here

# Which voice provider to use. Only "xai" exists today. See server/providers/index.js to add more.
VOICE_PROVIDER=xai
# Voice model and voice name. Pin a version (grok-voice-3.0), not the "latest" alias, so a model update cannot change the receptionist overnight.
XAI_VOICE_MODEL=grok-voice-3.0
XAI_VOICE=ara
# What the provider charges per minute, in US dollars. Only used for the cost in the logs.
VOICE_USD_PER_MINUTE=0.08

# ---------------------------------------------------------------- Server
# Port to listen on. Railway sets this for you.
PORT=8787
# The public https address of THIS backend, no trailing slash. Twilio needs it for webhooks.
# Example: https://frontdesk-api.up.railway.app
PUBLIC_URL=
# Websites allowed to call this backend from the browser, comma separated.
# Example: https://frontdeskai.co.za,https://www.frontdeskai.co.za
# Leave empty when the backend serves the website itself (Docker).
ALLOWED_ORIGINS=
# Set to "false" only if the server is NOT behind a proxy (Railway, Caddy and Nginx are proxies).
TRUST_PROXY=true

# ---------------------------------------------------------------- Demo limits (keep the xAI bill tiny)
# Longest demo call, in seconds.
DEMO_MAX_SECONDS=180
# How many demo calls (browser plus phone) can run at the same time.
DEMO_MAX_CONCURRENT=3
# How many browser demo calls one visitor (IP address) may start per hour.
DEMO_SESSIONS_PER_IP_PER_HOUR=5
# Hard ceiling on browser demo calls per day, across all visitors.
DEMO_SESSIONS_PER_DAY=200

# ---------------------------------------------------------------- Phone testing with Twilio (optional)
# Leave these three empty to hide the phone test. The microphone demo keeps working.
# Find them at https://console.twilio.com (Account Info).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Your Twilio number in international format, for example +27211234567
TWILIO_PHONE_NUMBER=
# One test call per phone number per hour, and a few per visitor.
PHONE_CALLS_PER_NUMBER_PER_HOUR=1
PHONE_CALLS_PER_IP_PER_HOUR=3
# Which numbers the call-me form may dial, by prefix, comma separated. +27 is South Africa.
PHONE_ALLOWED_PREFIXES=+27
# What Twilio charges you per minute, in US dollars (see your Twilio pricing page). Only used for the cost in the logs.
PHONE_USD_PER_MINUTE=0

# ---------------------------------------------------------------- Website build settings (used by "npm run build")
# These are public, not secret. Set them on Netlify or Vercel, or before building locally.
# The site's own address. PLACEHOLDER domain until you register yours.
SITE_URL=https://frontdeskai.co.za
# Where the backend lives when the website is hosted separately (Netlify or Vercel).
# Leave empty when the backend serves the website itself (Docker or npm start).
PUBLIC_API_BASE=
# From Google Search Console, "HTML tag" verification method. Only the code inside content="...".
GOOGLE_SITE_VERIFICATION=PLACEHOLDER_GOOGLE_SITE_VERIFICATION
