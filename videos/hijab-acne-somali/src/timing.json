{
 "scenes": [
  {
   "id": "q",
   "text": "Ma ku soo baxaan finan meesha xijaabku taabto?",
   "s": 0.3,
   "e": 2.645
  },
  {
   "id": "cause",
   "text": "Dhidid, saliid iyo xoqid joogto ah ayaa daloolada xiri kara.",
   "s": 3.285,
   "e": 6.569
  },
  {
   "id": "name",
   "text": "Tan waxaa la yiraahdaa finanka xoqidda iyo cadaadiska.",
   "s": 7.209,
   "e": 9.918
  },
  {
   "id": "wash",
   "text": "Marka hore, xijaabka hoose dhaq dhowrkii maalmoodba mar.",
   "s": 10.558,
   "e": 13.537
  },
  {
   "id": "fabric",
   "text": "Dooro maro neefsata sida suufka, gaar ahaan xilliga kulaylka.",
   "s": 14.177,
   "e": 17.458
  },
  {
   "id": "dry",
   "text": "Xijaabka ha ku xiran adigoo timaha ama wejigu qoyan yihiin.",
   "s": 18.098,
   "e": 21.12
  },
  {
   "id": "night",
   "text": "Habeenkii si tartiib ah u nadiifi wejiga iyo xariiqda timaha.",
   "s": 21.76,
   "e": 25.078
  },
  {
   "id": "soap",
   "text": "Haddii maqaarkaagu xasaasi yahay, dooro saabuunta dharka oo aan caraf lahayn.",
   "s": 25.718,
   "e": 29.783
  },
  {
   "id": "tight",
   "text": "Xijaabka ha u xirin si aad u adag oo wejiga cadaadiya.",
   "s": 30.423,
   "e": 33.343
  },
  {
   "id": "pride",
   "text": "Xijaabkaagu waa qurux, maqaarkaaguna daryeel ayuu mudan yahay.",
   "s": 33.983,
   "e": 37.402
  },
  {
   "id": "cta",
   "text": "La wadaag qof u baahan taladan, lana soco Skincare by Ubah.",
   "s": 38.042,
   "e": 41.342
  }
 ],
