      #lb-mag { position: absolute; left: 560px; top: 30px; width: 280px; height: 280px; }
      #lb-1 { left: 560px; top: 340px; } #lb-2 { left: 290px; top: 565px; }

      /* 7 no list, unknown seller: don't buy */
      #nl-left { left: 10px; } #nl-right { left: 470px; }
      #nl-tag { left: 250px; top: 500px; font-size: 52px; height: 86px; background: var(--terra); border-color: #fff; color: #fff; }
