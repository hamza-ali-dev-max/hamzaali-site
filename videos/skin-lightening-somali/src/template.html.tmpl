        <div class="stage">
          <div class="chip"><i></i>TALLAABO 2<i></i></div>
          <div class="headline"><span class="hl"><span class="hw y">Ha</span> <span class="hw y">iibsan</span></span><span class="hl sm"><span class="hw">liis</span> <span class="hw">la'aan</span></span></div>
          <div class="visual">
            <div class="card2" id="nl-left">
              <div class="disc"><svg viewBox="0 0 340 340" style="left: 0; top: 0; width: 340px; height: 340px"><g transform="translate(40 70) scale(.62)"><use href="#whiten-real" width="330" height="300" /></g><g transform="translate(220 150) rotate(8)"><rect x="0" y="0" width="90" height="120" rx="10" fill="#ffffff" stroke="#e3c173" stroke-width="4" /><text x="45" y="92" text-anchor="middle" font-family="Dancing Script" font-weight="700" font-size="90" fill="#b8452f">?</text></g></svg><svg class="ban" id="nl-ban1" viewBox="0 0 340 340"><g fill="none" stroke="#b8452f" stroke-width="22"><circle cx="170" cy="170" r="150" /><path d="M64 64 L276 276" /></g></svg></div>
              <div class="lab"><i style="background: var(--navy)"></i>Liis ma leh</div>
            </div>
            <div class="card2" id="nl-right">
              <div class="disc"><svg viewBox="0 0 340 340" style="left: 0; top: 0; width: 340px; height: 340px"><path d="M120 110 Q120 60 170 60 Q220 60 220 110" fill="none" stroke="#8a5a36" stroke-width="12" /><path d="M86 104 H254 L270 280 H70 Z" fill="#e3c173" /><path d="M86 104 H254 L258 140 H82 Z" fill="#c9a24b" /><text x="170" y="256" text-anchor="middle" font-family="Dancing Script" font-weight="700" font-size="120" fill="#ffffff">?</text></svg><svg class="ban" id="nl-ban2" viewBox="0 0 340 340"><g fill="none" stroke="#b8452f" stroke-width="22"><circle cx="170" cy="170" r="150" /><path d="M64 64 L276 276" /></g></svg></div>
              <div class="lab"><i style="background: var(--gold)"></i>Aan la hubin</div>
            </div>
            <div class="lab tag" id="nl-tag"><i></i>Ha iibsan</div>
          </div>
        </div>
      </section>

      <!-- 8. YOUR SKIN COLOUR IS BEAUTIFUL -->
      <section id="s-beauty" class="clip" data-start="%beauty.start%" data-duration="%beauty.dur%" data-track-index="1">
        <div class="stage">
          <div class="chip alt"><i></i>XUSUUS<i></i></div>
          <div class="headline"><span class="hl"><span class="hw y">Waa</span> <span class="hw y">qurux</span></span><span class="hl sm"><span class="hw">midabkaaga</span></span></div>
          <div class="visual">
            <svg class="hface stk" id="bt-face" viewBox="0 0 460 560"><use href="#hface-art" width="460" height="560" /><g id="bt-spark" fill="#e3c173"><path d="M60 120 l10 24 24 10 -24 10 -10 24 -10 -24 -24 -10 24 -10z" /><path d="M400 90 l8 18 18 8 -18 8 -8 18 -8 -18 -18 -8 18 -8z" /><path d="M410 380 l10 24 24 10 -24 10 -10 24 -10 -24 -24 -10 24 -10z" /></g></svg>
            <svg id="bt-pal" class="stk" viewBox="0 0 380 440">
              <rect x="0" y="0" width="380" height="440" rx="36" fill="#ffffff" />
              <g class="sw"><circle cx="110" cy="90" r="58" fill="#f1c9a5" /><circle cx="270" cy="90" r="58" fill="#d9a27a" /><circle cx="110" cy="220" r="58" fill="#b97a52" /><circle cx="270" cy="220" r="58" fill="#8d5a3b" /><circle cx="110" cy="350" r="58" fill="#6b4029" /><circle cx="270" cy="350" r="58" fill="#4a2a1a" /></g>
              <g class="ht" fill="#2f6fd0" stroke="#ffffff" stroke-width="4"><path transform="translate(140 110)" d="M18 34 C4 24 0 18 0 11 C0 5 4 1 9 1 C13 1 16 3 18 7 C20 3 23 1 27 1 C32 1 36 5 36 11 C36 18 32 24 18 34Z" /><path transform="translate(300 110)" d="M18 34 C4 24 0 18 0 11 C0 5 4 1 9 1 C13 1 16 3 18 7 C20 3 23 1 27 1 C32 1 36 5 36 11 C36 18 32 24 18 34Z" /><path transform="translate(140 240)" d="M18 34 C4 24 0 18 0 11 C0 5 4 1 9 1 C13 1 16 3 18 7 C20 3 23 1 27 1 C32 1 36 5 36 11 C36 18 32 24 18 34Z" /><path transform="translate(300 240)" d="M18 34 C4 24 0 18 0 11 C0 5 4 1 9 1 C13 1 16 3 18 7 C20 3 23 1 27 1 C32 1 36 5 36 11 C36 18 32 24 18 34Z" /><path transform="translate(140 370)" d="M18 34 C4 24 0 18 0 11 C0 5 4 1 9 1 C13 1 16 3 18 7 C20 3 23 1 27 1 C32 1 36 5 36 11 C36 18 32 24 18 34Z" /><path transform="translate(300 370)" d="M18 34 C4 24 0 18 0 11 C0 5 4 1 9 1 C13 1 16 3 18 7 C20 3 23 1 27 1 C32 1 36 5 36 11 C36 18 32 24 18 34Z" /></g>
            </svg>
            <div class="lab tag" id="bt-1"><i style="background: var(--gold)"></i>Qurux</div>
            <div class="lab tag" id="bt-2"><i style="background: var(--blue)"></i>Ha beddelin</div>
          </div>
        </div>
      </section>

      <!-- 9. WORRIED ABOUT DARK SPOTS? SEE A DERMATOLOGIST -->
      <section id="s-doctor" class="clip" data-start="%doctor.start%" data-duration="%doctor.dur%" data-track-index="1">
        <div class="stage">
          <div class="chip"><i></i>TALLAABO 3<i></i></div>
          <div class="headline"><span class="hl"><span class="hw y">Bar</span> <span class="hw y">madow?</span></span><span class="hl sm"><span class="hw">la</span> <span class="hw">tasho</span> <span class="hw">dhakhtarka</span></span></div>
          <div class="visual">
            <svg id="dr-skin" class="stk" viewBox="0 0 400 400"><circle cx="200" cy="200" r="190" fill="url(#u-skin)" /><ellipse cx="170" cy="190" rx="54" ry="44" fill="#5c3520" opacity=".75" /><ellipse cx="250" cy="250" rx="26" ry="22" fill="#5c3520" opacity=".6" /><ellipse cx="120" cy="110" rx="60" ry="30" fill="#ffffff" opacity=".12" /><g id="dr-ring"><circle cx="170" cy="190" r="86" fill="none" stroke="#2f6fd0" stroke-width="10" stroke-dasharray="20 14" /></g></svg>
            <svg id="dr-doc" class="stk" viewBox="0 0 380 380"><use href="#doc-badge" width="380" height="380" /></svg>
            <div class="lab tag" id="dr-1"><i style="background: #5c3520"></i>Bar madow</div>
            <div class="lab tag" id="dr-2"><i style="background: var(--blue)"></i>Dhakhtarka maqaarka</div>
          </div>
        </div>
      </section>

      <!-- 10. DAILY SUNSCREEN -->
      <section id="s-spf" class="clip" data-start="%spf.start%" data-duration="%spf.dur%" data-track-index="1">
        <div class="stage">
          <div class="chip"><i></i>TALLAABO 4<i></i></div>
          <div class="headline"><span class="hl"><span class="hw y">Qorraxda</span></span><span class="hl sm"><span class="hw">maalin</span> <span class="hw">kasta</span></span></div>
          <div class="visual">
            <svg id="sp-disc" class="stk" viewBox="0 0 420 420"><circle cx="210" cy="210" r="200" fill="#ffffff" /><circle cx="170" cy="170" r="70" fill="#e3c173" /><g stroke="#c9a24b" stroke-width="12" stroke-linecap="round"><path d="M170 70 v24 M170 246 v24 M70 170 h24 M246 170 h24 M100 100 l17 17 M223 223 l17 17 M100 240 l17 -17 M223 117 l17 -17" /></g><path d="M250 210 L340 240 V300 C340 350 300 380 250 396 C200 380 160 350 160 300 V240 Z" fill="#2f6fd0" stroke="#ffffff" stroke-width="8" /><path d="M250 250 l10 30 h32 l-26 18 10 30 -26 -18 -26 18 10 -30 -26 -18 h32 z" fill="#ffffff" /></svg>
            <svg id="sp-bottle" class="stk" viewBox="0 0 260 560"><use href="#spf-real" width="260" height="560" /></svg>
            <div class="lab tag" id="sp-1"><i style="background: var(--gold)"></i>Maalin kasta</div>
            <div class="lab tag" id="sp-2"><i style="background: var(--blue)"></i>Ammaan</div>
          </div>
        </div>
      </section>

      <!-- 11. SHARE + FOLLOW -->
      <section id="s-cta" class="clip" data-start="%cta.start%" data-duration="%cta.dur%" data-track-index="1">
        <div class="stage">
          <div class="chip"><i></i>LA WADAAG<i></i></div>
          <div class="headline"><span class="hl"><span class="hw y">La</span> <span class="hw y">wadaag</span></span><span class="hl sm"><span class="hw">lana</span> <span class="hw">soco</span></span></div>
          <div class="visual">
            <div id="pfp"><svg viewBox="0 0 460 560"><use href="#hface-art" width="460" height="560" /></svg></div>
            <div id="brandname">Skincare by Ubah</div>
            <div id="follow" class="center stk"><svg id="tiktok" viewBox="0 0 48 48"><rect width="48" height="48" rx="11" fill="#000000" /><g transform="translate(7.8 7.8) scale(1.35)"><path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.650-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z" fill="#25f4ee" transform="translate(-0.9 -0.9)" /><path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.650-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z" fill="#fe2c55" transform="translate(0.9 0.9)" /><path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.650-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z" fill="#ffffff" /></g></svg><span>LA SOCO</span></div>
            <div id="shareit" class="center stk"><svg width="54" height="54" viewBox="0 0 64 64"><path d="M36 10 L58 30 L36 50 V38 C22 38 12 42 6 54 C8 34 18 24 36 22 Z" fill="#2f6fd0" /></svg><span>LA WADAAG</span></div>
          </div>
        </div>
      </section>

      <!-- persistent chrome above scenes -->
      <div id="brand"><svg width="30" height="28" viewBox="0 0 46 42"><path d="M23 40 C8 28 2 20 2 12 C2 6 7 2 12 2 C17 2 21 5 23 9 C25 5 29 2 34 2 C39 2 44 6 44 12 C44 20 38 28 23 40Z" fill="#2f6fd0" /></svg>SKINCARE BY UBAH</div>
      <div id="prog"><span id="prog-fill"></span></div>
      <div id="caps">
        %CAPTIONS%
      </div>
      <div id="flash"></div>

    %AUDIO%
    </div>
    <script>
      const D = %DATA%;
      const tl = gsap.timeline({ paused: true });
      const S = {};
      D.scenes.forEach((s) => (S[s.id] = s));
      const B = D.beats;
      const q = (sel) => document.querySelector(sel);
      const pop = (sel, t, from = 0.3) => tl.fromTo(sel, { scale: from, opacity: 0 }, { scale: 1, opacity: 1, duration: 0.35, ease: "back.out(2.4)" }, t);
      const ban = (sel, t) => tl.fromTo(sel, { opacity: 0, scale: 1.5, transformOrigin: "50% 50%" }, { opacity: 1, scale: 1, duration: 0.25, ease: "power4.in" }, t);

      // persistent theme motion: the woven lattice and patterned band drift slowly, progress fills
      tl.fromTo("#weave", { backgroundPosition: "0px 0px" }, { backgroundPosition: "0px 220px", duration: D.total, ease: "none" }, 0);
      tl.fromTo("#band", { backgroundPosition: "0px 0px" }, { backgroundPosition: "220px 0px", duration: D.total, ease: "none" }, 0);
      tl.fromTo("#prog-fill", { scaleX: 0 }, { scaleX: 1, duration: D.total, ease: "none" }, 0);

      // every scene: hard cut + gold flash, punch-in landing, a mid-scene jump-cut zoom
      D.scenes.forEach((s, i) => {
        const el = q("#s-" + s.id);
        const stage = el.querySelector(".stage");
        const dir = i % 2 ? -1 : 1;
        tl.fromTo(stage, { scale: 1.16, x: 90 * dir }, { scale: 1, x: 0, duration: 0.38, ease: "power3.out" }, s.start);
        const jump = s.start + s.dur * 0.56;
        tl.set(stage, { scale: 1.07 }, jump);
        tl.to(stage, { scale: 1.1, duration: s.dur * 0.44 - 0.02, ease: "none" }, jump + 0.01);
        if (i > 0) {
          tl.set("#flash", { opacity: 0.55 }, s.start);
          tl.to("#flash", { opacity: 0, duration: 0.16, ease: "power2.out" }, s.start + 0.001);
        }
        tl.fromTo(el.querySelector(".chip"), { scale: 0.4, opacity: 0 }, { scale: 1, opacity: 1, duration: 0.3, ease: "back.out(3)" }, s.start + 0.05);
        tl.fromTo(el.querySelectorAll(".hw"), { yPercent: 105 }, { yPercent: 0, duration: 0.42, stagger: 0.06, ease: "power4.out" }, s.start + 0.08);
      });

      // 1 do you use a lightening cream?
      pop("#q-face", S.q.start + 0.1);
      tl.fromTo("#q-jar", { x: 400, rotation: 12 }, { x: 0, rotation: -5, duration: 0.45, ease: "back.out(1.4)" }, B.cream - 0.2);
      tl.fromTo("#q-mark", { scale: 0, rotation: -30 }, { scale: 1, rotation: 8, duration: 0.35, ease: "back.out(3)" }, B.cream + 0.6);

      // 2 many hide dangerous ingredients that aren't on the label
      pop("#h-jar", S.hidden.start + 0.15);
      tl.fromTo("#h-haz .hz", { scale: 0, opacity: 0, transformOrigin: "50% 50%" }, { scale: 1, opacity: 1, duration: 0.3, stagger: 0.12, ease: "back.out(3)" }, B.danger - 0.1);
      pop("#h-1", B.danger + 0.1);
      tl.fromTo("#h-label", { x: 400, opacity: 0 }, { x: 0, opacity: 1, duration: 0.4, ease: "power3.out" }, B.label - 0.3);
      tl.fromTo("#h-q", { scale: 0, transformOrigin: "50% 70%" }, { scale: 1, duration: 0.35, ease: "back.out(3)" }, B.label + 0.3);
      pop("#h-2", B.nolabel);

      // 3 mercury: kidneys and nerves
      pop("#m-hg", B.hg - 0.1);
      tl.fromTo("#m-hg .drop ellipse", { scale: 0, transformOrigin: "50% 50%" }, { scale: 1, duration: 0.3, stagger: 0.08, ease: "back.out(3)" }, B.hg + 0.3);
      pop("#m-kid", B.kid - 0.15);
      tl.fromTo("#m-kx", { scale: 0, transformOrigin: "50% 50%" }, { scale: 1, duration: 0.3, ease: "back.out(3)" }, B.kid + 0.25);
      pop("#m-1", B.kid + 0.1);
      pop("#m-nerve", B.nerve - 0.15);
      tl.fromTo("#m-zap", { opacity: 0 }, { opacity: 1, duration: 0.07, yoyo: true, repeat: 5 }, B.nerve + 0.2);
      tl.set("#m-zap", { opacity: 1 }, B.nerve + 0.62);
      pop("#m-2", B.nerve + 0.2);

      // 4 strong steroids thin the skin, bring pimples and stretch marks
      pop("#st-x", S.steroid.start + 0.15);
      tl.to(["#st-epi", "#st-der"], { scaleY: 0.45, transformOrigin: "50% 100%", duration: 0.7, ease: "power2.inOut" }, B.thin);
      tl.to("#st-epi", { y: 66, duration: 0.7, ease: "power2.inOut" }, B.thin);
      pop("#st-1", B.thin + 0.3);
      pop("#st-face", B.zits - 0.5);
      tl.fromTo("#st-zits circle", { scale: 0, transformOrigin: "50% 50%" }, { scale: 1, duration: 0.2, stagger: 0.06, ease: "back.out(3)" }, B.zits);
      pop("#st-2", B.zits + 0.1);
      pop("#st-str", B.marks - 0.3);
      tl.fromTo("#st-str .sm-line path", { strokeDasharray: 400, strokeDashoffset: 400 }, { strokeDashoffset: 0, duration: 0.4, stagger: 0.12, ease: "power2.out" }, B.marks);
      pop("#st-3", B.marks + 0.2);

      // 5 stop using it and the skin can turn darker than before
      pop("#r-1", S.rebound.start + 0.15);
      pop("#ra-1", S.rebound.start + 0.45);
      pop("#r-2", S.rebound.start + 0.55);
      pop("#ra-2", B.stop - 0.1);
      pop("#r-3", B.stop);
      tl.fromTo("#r-dark", { opacity: 0 }, { opacity: 0.85, duration: 0.6 }, B.dark - 0.2);
      pop("#r-tag", B.dark);

      // 6 read the label: avoid mercury, calomel, clobetasol (unless prescribed)
      pop("#lb-card", S.label.start + 0.1);
      tl.fromTo("#lb-mag", { x: 300, rotation: 20 }, { x: 0, rotation: 0, duration: 0.45, ease: "back.out(1.6)" }, B.read);
      pop("#lb-1", B.avoid);
      [["#lb-r1", B.merc], ["#lb-r2", B.calo], ["#lb-r3", B.clob]].forEach(([r, t]) => {
        tl.fromTo(r + " .hi", { opacity: 0 }, { opacity: 1, duration: 0.15 }, t);
        tl.fromTo(r + " .st", { strokeDasharray: 400, strokeDashoffset: 400 }, { strokeDashoffset: 0, duration: 0.3, ease: "power2.out" }, t + 0.1);
      });
      tl.to("#lb-mag", { y: 220, duration: 1.4, ease: "power1.inOut" }, B.merc - 0.1);
      pop("#lb-2", B.rx);

      // 7 no ingredient list, unknown source: don't buy
      pop("#nl-left", B.list - 0.2);
      pop("#nl-right", B.place - 0.2);
      ban("#nl-ban1", B.nobuy);
      ban("#nl-ban2", B.nobuy + 0.1);
      pop("#nl-tag", B.nobuy + 0.1, 0.5);

      // 8 your skin colour is beautiful; no need to change it
      pop("#bt-face", S.beauty.start + 0.1);
      pop("#bt-pal", S.beauty.start + 0.35);
      tl.fromTo("#bt-spark path", { scale: 0, transformOrigin: "50% 50%" }, { scale: 1, duration: 0.3, stagger: 0.1, ease: "back.out(3)" }, B.pretty);
      tl.fromTo("#bt-pal .ht path", { scale: 0, opacity: 0, transformOrigin: "50% 50%" }, { scale: 1, opacity: 1, duration: 0.25, stagger: 0.08, ease: "back.out(3)" }, B.pretty + 0.1);
      pop("#bt-1", B.pretty);
      pop("#bt-2", B.change - 0.3);

      // 9 dark spots: talk to a dermatologist
      pop("#dr-skin", B.spot - 0.2);
      tl.fromTo("#dr-ring", { scale: 1.6, opacity: 0, transformOrigin: "170px 190px" }, { scale: 1, opacity: 1, duration: 0.35, ease: "back.out(2)" }, B.spot + 0.2);
      pop("#dr-1", B.spot + 0.2);
      pop("#dr-doc", B.derm - 0.2);
      pop("#dr-2", B.derm + 0.1);

      // 10 daily sunscreen protects safely
      pop("#sp-disc", S.spf.start + 0.15);
      tl.fromTo("#sp-bottle", { y: 600 }, { y: 0, duration: 0.45, ease: "back.out(1.4)" }, B.spf - 0.2);
      pop("#sp-1", B.daily);
      pop("#sp-2", B.safe);

      // 11 share, then follow Skincare by Ubah
      pop("#pfp", S.cta.start + 0.1);
      tl.fromTo("#shareit", { y: 240, opacity: 0 }, { y: 0, opacity: 1, duration: 0.35, ease: "back.out(2)" }, B.share - 0.1);
      tl.fromTo("#follow", { y: 240, opacity: 0 }, { y: 0, opacity: 1, duration: 0.35, ease: "back.out(2)" }, B.follow - 0.1);
      tl.fromTo("#tiktok", { scale: 0, rotation: -30 }, { scale: 1, rotation: 0, duration: 0.4, ease: "back.out(3)" }, B.follow + 0.05);
      pop("#brandname", B.brand - 0.1, 0.6);

      // captions: word-by-word karaoke in Somali (active word in Somali blue)
      D.caps.forEach((g, gi) => {
        const line = "#cap-" + gi;
        tl.set(line, { opacity: 1 }, g.s);
        tl.fromTo(line, { scale: 0.86 }, { scale: 1, duration: 0.12, ease: "back.out(3)", immediateRender: false }, g.s);
        tl.set(line, { opacity: 0 }, g.e);
        g.w.forEach((w, wi) => {
          const id = "#cw-" + gi + "-" + wi;
          tl.set(id, { color: "#2f6fd0" }, w.s);
          if (wi + 1 < g.w.length) tl.set(id, { color: "#4a2e1a" }, g.w[wi + 1].s);
        });
      });

      window.__timelines["main"] = tl;
    </script>
  </body>
</html>
