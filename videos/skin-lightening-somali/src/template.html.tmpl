      #brandname { position: absolute; left: 40px; top: 310px; width: 800px; text-align: center; font-family: "Dancing Script"; font-weight: 700; font-size: 96px; color: var(--blue); line-height: 1.1; }
      #follow { position: absolute; left: 60px; top: 460px; width: 380px; height: 120px; border-radius: 60px; background: var(--blue); gap: 18px; color: #fff; font-family: "Cinzel"; font-weight: 900; font-size: 40px; }
