{
 "scenes": [
  {
   "id": "q",
   "text": "Ma isticmaashaa kareem maqaarka cadeeya?",
   "s": 0.3,
   "e": 2.309
  },
  {
   "id": "hidden",
   "text": "Qaar badan oo ka mid ah waxaa ku jira walxo khatar ah oo aan summadda lagu qorin.",
   "s": 2.949,
   "e": 7.195
  },
  {
   "id": "mercury",
   "text": "Meerkuri wuxuu dhaawici karaa kelyaha iyo dareemayaasha.",
   "s": 7.835,
   "e": 10.824
  },
  {
   "id": "steroid",
   "text": "Steroid-ka xooggan wuxuu khafiifin karaa maqaarka, wuxuuna keeni karaa finan iyo xariijimo.",
   "s": 11.464,
   "e": 16.351
  },
  {
   "id": "rebound",
   "text": "Marka la joojiyo, maqaarku wuxuu noqon karaa mid ka madow sidii hore.",
   "s": 16.991,
   "e": 20.721
  },
  {
   "id": "label",
   "text": "Akhri summadda, kana fogow mercury, calomel iyo clobetasol aan dhakhtar kuu qorin.",
   "s": 21.361,
   "e": 25.779
  },
  {
   "id": "nolist",
   "text": "Kareem aan liiska walxaha lahayn ama meel aan la hubin laga keenay, ha iibsan.",
   "s": 26.419,
   "e": 30.486
  },
  {
   "id": "beauty",
   "text": "Midabka maqaarkaagu waa qurux, uma baahna in la beddelo.",
   "s": 31.126,
   "e": 34.166
  },
  {
   "id": "doctor",
   "text": "Haddii aad bar madow ka welwelsan tahay, la tasho dhakhtarka maqaarka.",
   "s": 34.806,
   "e": 38.459
  },
  {
   "id": "spf",
   "text": "Kareemka qorraxda maalin kasta ayaa si ammaan ah u ilaaliya maqaarkaaga.",
   "s": 39.099,
   "e": 42.808
  },
  {
   "id": "cta",
   "text": "La wadaag qof u baahan taladan, lana soco Skincare by Ubah.",
   "s": 43.448,
   "e": 46.748
  }
 ],
