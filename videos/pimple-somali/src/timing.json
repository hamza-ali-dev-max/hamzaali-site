{
 "scenes": [
  {
   "id": "hook",
   "text": "Ma tuujisaa finankaaga? Jooji! Waxay kaa reebi kartaa nabar joogto ah.",
   "s": 0.3,
   "e": 4.687
  },
  {
   "id": "inside",
   "text": "Finku waa dalool maqaar oo xiran, oo ay ku jiraan saliid, unugyo dhintay, iyo bakteeriya.",
   "s": 5.587,
   "e": 10.151
  },
  {
   "id": "deeper",
   "text": "Markaad tuujiso, bakteeriyadu gudaha ayay u sii gashaa, bararkuna wuu sii weynaadaa.",
   "s": 11.051,
   "e": 15.359
  },
  {
   "id": "spread",
   "text": "Waxa kale oo aad faafin kartaa caabuqa, finan cusubna way soo baxaan.",
   "s": 16.259,
   "e": 19.797
  },
  {
   "id": "scar",
   "text": "Maqaarku wuu dhaawacmaa, wuxuuna kaa reebaa nabar ama bar madow.",
   "s": 20.697,
   "e": 23.979
  },
  {
   "id": "wash",
   "text": "Taa beddelkeed: wejiga si tartiib ah u dhaq, laba jeer maalintii.",
   "s": 24.879,
   "e": 28.213
  },
  {
   "id": "notouch",
   "text": "Ha taaban wejigaaga, isticmaalna kareem finanka loogu talagalay.",
   "s": 29.113,
   "e": 32.395
  },
  {
   "id": "doctor",
   "text": "Haddii ay xanuun badan yihiin ama aysan tegin, la tasho dhakhtarka maqaarka.",
   "s": 33.295,
   "e": 37.192
  },
  {
   "id": "cta",
   "text": "Maqaarkaaga u naxariiso, ha tuujin! U dir qof aad jeceshahay.",
   "s": 38.092,
   "e": 41.619
  }
 ],
