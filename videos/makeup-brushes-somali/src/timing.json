{
 "scenes": [
  {
   "id": "q",
   "text": "Goormaa kuugu dambaysay inaad dhaqdo burushyada makeup-kaaga?",
   "s": 0.3,
   "e": 3.459
  },
  {
   "id": "time",
   "text": "Haddii aadan xasuusan, waa waqtigii aad nadiifin lahayd!",
   "s": 4.099,
   "e": 7.024
  },
  {
   "id": "buildup",
   "text": "Burushyada waxaa ku urura haraaga makeup-ka, saliid iyo bakteeriya.",
   "s": 7.664,
   "e": 11.262
  },
  {
   "id": "often",
   "text": "Dhaq toddobadii ilaa tobankii maalmoodba mar.",
   "s": 11.902,
   "e": 14.148
  },
  {
   "id": "shampoo",
   "text": "Isticmaal biyo diirran iyo shaambo jilicsan, adigoo nadiifinaya timaha burushka.",
   "s": 14.788,
   "e": 19.103
  },
  {
   "id": "rinse",
   "text": "Si fiican u raaci ilaa biyuhu nadiif noqdaan.",
   "s": 19.743,
   "e": 22.233
  },
  {
   "id": "towel",
   "text": "Biyaha dheeraadka ah kaga saar tuwaal nadiif ah.",
   "s": 22.873,
   "e": 25.294
  },
  {
   "id": "flat",
   "text": "Jiifi burushyada si ay u qalalaan, hana taagin iyagoo qoyan.",
   "s": 25.934,
   "e": 29.318
  },
  {
   "id": "noshare",
   "text": "Qof kale ha la wadaagin burushyadaada.",
   "s": 29.958,
   "e": 31.82
  },
  {
   "id": "clean",
   "text": "Daryeelka wejigu wuxuu ka bilaabmaa qalab nadiif ah!",
   "s": 32.46,
   "e": 35.213
  },
  {
   "id": "cta",
   "text": "La wadaag saaxiibtaa, lana soco Skincare by Ubah.",
   "s": 35.853,
   "e": 38.556
  }
 ],
