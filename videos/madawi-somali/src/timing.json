{
 "scenes": [
  {
   "id": "l1",
   "text": "Waxaan idin tusayaa Madawi, oo ka socda Arabian Oud!",
   "s": 0.3,
   "e": 3.048
  },
  {
   "id": "l2",
   "text": "Madawi waxaa loo sameeyay xushmadda hooyada aasaasihii Arabian Oud.",
   "s": 3.688,
   "e": 7.122
  },
  {
   "id": "l3",
   "text": "Waxaa sameeyay laba khabiir oo cadar, Claire Liégent iyo Dominique Ropion.",
   "s": 7.762,
   "e": 11.808
  },
  {
   "id": "l4",
   "text": "Wuxuu ku bilaabmaa peach iyo ubaxa tufaaxa, wadnihiisuna waa ubaxa cananaaska.",
   "s": 12.448,
   "e": 17.004
  },
  {
   "id": "l5",
   "text": "Salkiisa hoose waa misk, ward duurjoog ah iyo patchouli.",
   "s": 17.644,
   "e": 20.817
  },
  {
   "id": "l6",
   "text": "Waa udgoon isku darka Bariga iyo Galbeedka.",
   "s": 21.457,
   "e": 23.795
  },
  {
   "id": "l7",
   "text": "Waxaad ka heli kartaa Falarosa Luxury, Surrey, BC, Kanada.",
   "s": 24.435,
   "e": 27.764
  },
  {
   "id": "l8",
   "text": "Nagala soo xiriir lambarka ku qoran bogga.",
   "s": 28.404,
   "e": 30.541
  },
  {
   "id": "l9",
   "text": "Madawi, Arabian Oud. Hadda dalbo!",
   "s": 31.181,
   "e": 33.523
  }
 ],
