{
 "scenes": [
  {
   "id": "l1",
   "text": "Waxaan idin tusayaa cadarrada Taif Al Emarat, ururka Romance!",
   "s": 0.3,
   "e": 3.777
  },
  {
   "id": "l2",
   "text": "Midka ugu udgoonka xooggan waa Romance N°3, oo la soo saaray labo kun iyo shan iyo labaatan.",
   "s": 4.417,
   "e": 9.948
  },
  {
   "id": "l3",
   "text": "Wuxuu ku bilaabmaa ward Taif ah, wadnihiisu waa geranium, salkiisuna waa misk jilicsan.",
   "s": 10.588,
   "e": 15.533
  },
  {
   "id": "l4",
   "text": "Waxaa lagu sameeyay aalkolo dabiici ah oo aan caraf lahayn, saliid udgoon dabiici ah iyo citrus.",
   "s": 16.173,
   "e": 21.719
  },
  {
   "id": "l5",
   "text": "Waa toddobaatan iyo shan mililitir, waxaana lagu sameeyay Imaaraadka Carabta.",
   "s": 22.359,
   "e": 26.399
  },
  {
   "id": "l6",
   "text": "Ragga iyo dumarkaba wuu ku habboon yahay.",
   "s": 27.039,
   "e": 29.093
  },
  {
   "id": "l7",
   "text": "Udgoonkiisu muddo dheer ayuu ku jiraa dharkaaga iyo jirkaaga, wuuna sii uraa.",
   "s": 29.733,
   "e": 33.967
  },
  {
   "id": "l8",
   "text": "Waxaad ka heli kartaa Falarosa Luxury, Surrey, BC, Kanada.",
   "s": 34.607,
   "e": 37.93
  },
  {
   "id": "l9",
   "text": "Nagala soo xiriir lambarka ku qoran bogga.",
   "s": 38.57,
   "e": 40.707
  },
  {
   "id": "l10",
   "text": "Romance N°3, Taif Al Emarat. Hadda dalbo!",
   "s": 41.347,
   "e": 44.55
  }
 ],
