{
 "scenes": [
  {
   "id": "hook",
   "text": "Romance N°3, oo ka socda Taif Al Emarat, ururka Romance!",
   "s": 0.3,
   "e": 4.041
  },
  {
   "id": "s2",
   "text": "Waa quraarad guduudan-buni ah, oo leh saxan dahab ah iyo dabool dahab ah.",
   "s": 4.681,
   "e": 8.774
  },
  {
   "id": "s3",
   "text": "Waxaa lagu sameeyay Imaaraadka Carabta, cabbirkuna waa toddobaatan iyo shan mililitir.",
   "s": 9.414,
   "e": 13.946
  },
  {
   "id": "s4",
   "text": "Qoraalka gadaal wuxuu sheegayaa aalkolo dabiici ah, saliid udgoon dabiici ah iyo citrus.",
   "s": 14.586,
   "e": 19.667
  },
  {
   "id": "how",
   "text": "Ku rusheey gacmaha iyo qoorta, jirka dibaddiisa oo keliya u isticmaal.",
   "s": 20.307,
   "e": 23.999
  },
  {
   "id": "fire",
   "text": "Way shidmi kartaa ilaa ay qalasho, sidaa darteed dabka iyo kulaylka ka fogee.",
   "s": 24.639,
   "e": 28.678
  },
  {
   "id": "store",
   "text": "Meel qabow oo qalalan ku kaydi, carruurtana ka fogee.",
   "s": 29.318,
   "e": 32.166
  },
  {
   "id": "cta",
   "text": "Romance N°3, udgoon Imaaraati ah. Hadda raadso!",
   "s": 32.806,
   "e": 36.339
  }
 ],
