{
 "scenes": [
  {
   "id": "l1",
   "text": "Waxaan idin tusayaa cadarrada Taif Al Emarat, ururka Romance!",
   "s": 0.3,
   "e": 3.777
  },
  {
   "id": "l2",
   "text": "Kani waa Romance N°2, udgoon ubax iyo xawaash ah, oo ragga iyo dumarkaba ku habboon.",
   "s": 4.417,
   "e": 9.414
  },
  {
   "id": "l3",
   "text": "Wuxuu ku bilaabmaa ward Moroccan ah iyo rosemary, wadnihiisuna waa citrus.",
   "s": 10.054,
   "e": 14.222
  },
  {
   "id": "l4",
   "text": "Salkiisa hoose waa qori cedar ah oo qallalan.",
   "s": 14.862,
   "e": 17.238
  },
  {
   "id": "l5",
   "text": "Waxaa lagu sameeyay aalkolo dabiici ah oo aan caraf lahayn iyo saliid udgoon dabiici ah.",
   "s": 17.878,
   "e": 22.682
  },
  {
   "id": "l6",
   "text": "Saxanka lacagta ah ee quraaradda waxaa ku qoran magaca Taif, far Carabi ah.",
   "s": 23.322,
   "e": 27.275
  },
  {
   "id": "l7",
   "text": "Haddii aad rabto udgoonka ugu xooggan, eeg Romance N°3.",
   "s": 27.915,
   "e": 31.25
  },
  {
   "id": "l8",
   "text": "Waxaad ka heli kartaa Falarosa Luxury, Surrey, BC, Kanada.",
   "s": 31.89,
   "e": 35.213
  },
  {
   "id": "l9",
   "text": "Nagala soo xiriir lambarka ku qoran bogga.",
   "s": 35.853,
   "e": 37.989
  },
  {
   "id": "l10",
   "text": "Romance N°2, Taif Al Emarat. Hadda dalbo!",
   "s": 38.629,
   "e": 41.694
  }
 ],
