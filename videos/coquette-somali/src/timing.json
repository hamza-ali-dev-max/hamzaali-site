{
 "scenes": [
  {
   "id": "l1",
   "text": "Gurigaaga ka dhig mid had iyo jeer udgoon!",
   "s": 0.3,
   "e": 2.509
  },
  {
   "id": "l2",
   "text": "Kani waa Coquette, oo ka socda Taif Al Emarat.",
   "s": 3.149,
   "e": 5.77
  },
  {
   "id": "l3",
   "text": "Waa buufin hawada guriga ah, laba boqol iyo konton mililitir.",
   "s": 6.41,
   "e": 9.845
  },
  {
   "id": "l4",
   "text": "Wuxuu ku bilaabmaa bergamot, citrus iyo filfil casaan ah.",
   "s": 10.485,
   "e": 13.64
  },
  {
   "id": "l5",
   "text": "Salkiisuna waa misk, patchouli iyo qori sandal ah oo jilicsan.",
   "s": 14.28,
   "e": 17.957
  },
  {
   "id": "l6",
   "text": "Ku buufi qolka fadhiga, qolka jiifka ama gaariga.",
   "s": 18.597,
   "e": 21.26
  },
  {
   "id": "l7",
   "text": "Martidaadu waxay dareemi doonaan udgoon qurux badan marka ay soo galaan.",
   "s": 21.9,
   "e": 25.619
  },
  {
   "id": "l8",
   "text": "Waxaad ka heli kartaa Falarosa Luxury, Surrey, BC, Kanada.",
   "s": 26.259,
   "e": 29.582
  },
  {
   "id": "l9",
   "text": "Nagala soo xiriir lambarka ku qoran bogga.",
   "s": 30.222,
   "e": 32.359
  },
  {
   "id": "l10",
   "text": "Coquette, Taif Al Emarat. Hadda dalbo!",
   "s": 32.999,
   "e": 35.588
  }
 ],
