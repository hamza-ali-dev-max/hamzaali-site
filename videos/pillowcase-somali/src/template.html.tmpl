<!doctype html>
<html lang="so" data-resolution="portrait">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=1080, height=1920" />
    <title>Galka Barkinta</title>
    <script src="assets/js/gsap.min.js"></script>
    <style>
      @font-face { font-family: "Dancing Script"; src: url("assets/fonts/dancing-700.woff2") format("woff2"); font-weight: 700; }
      @font-face { font-family: "Cinzel"; src: url("assets/fonts/cinzel-700.woff2") format("woff2"); font-weight: 700; }
      @font-face { font-family: "Cinzel"; src: url("assets/fonts/cinzel-900.woff2") format("woff2"); font-weight: 900; }
      @font-face { font-family: "Lora"; src: url("assets/fonts/lora-700.woff2") format("woff2"); font-weight: 700; }
      @font-face { font-family: "Lora"; src: url("assets/fonts/lora-600i.woff2") format("woff2"); font-weight: 600; font-style: italic; }
      :root {
        --paper: #fbf7f0;
        --sand: #efe4d2;
        --sand2: #f6eee1;
        --gold: #c9a24b;
        --gold2: #e3c173;
        --brown: #4a2e1a;
        --brown2: #8a5a36;
        --blue: #2f6fd0;
        --navy: #1c3f86;
        --terra: #b8452f;
        --skin: #8d5a3b;
        --sticker: drop-shadow(6px 0 0 #fff) drop-shadow(-6px 0 0 #fff) drop-shadow(0 6px 0 #fff) drop-shadow(0 -6px 0 #fff) drop-shadow(0 14px 14px rgba(74, 46, 26, 0.22));
      }
      * { margin: 0; padding: 0; box-sizing: border-box; }
      html, body { width: 1080px; height: 1920px; overflow: hidden; background: var(--paper); }
      #root { position: relative; width: 100%; height: 100%; overflow: hidden; font-family: "Lora", serif; color: var(--brown); background: var(--paper); }

      /* persistent heritage theme: warm paper, woven diamond lattice, patterned band */
      #bg { position: absolute; inset: 0; background: radial-gradient(1000px 900px at 50% 30%, #ffffff 0%, var(--paper) 55%, var(--sand2) 100%); }
      #weave { position: absolute; inset: 0; opacity: 0.55;
        background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='120' height='120'><path d='M60 6 L114 60 L60 114 L6 60 Z' fill='none' stroke='%23e3c173' stroke-width='2' opacity='.45'/><path d='M60 48 L72 60 L60 72 L48 60 Z' fill='%23c9a24b' opacity='.28'/></svg>");
        background-size: 120px 120px; }
      #band { position: absolute; left: 0; top: 0; width: 1080px; height: 30px;
        background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='60' height='30'><rect width='60' height='30' fill='%231c3f86'/><path d='M0 30 L15 6 L30 30Z' fill='%23c9a24b'/><path d='M30 30 L45 6 L60 30Z' fill='%23b8452f'/><path d='M15 0 L30 18 L45 0Z' fill='%23fbf7f0'/></svg>");
        background-size: 60px 30px; }
      #brand { position: absolute; left: 60px; top: 66px; display: flex; align-items: center; gap: 14px; font-family: "Cinzel"; font-weight: 700; font-size: 28px; letter-spacing: 0.16em; color: var(--brown); }
      #brand svg { display: block; }
      #prog { position: absolute; left: 60px; top: 118px; width: 820px; height: 10px; border-radius: 6px; background: var(--sand); overflow: hidden; }
      #prog-fill { display: block; width: 100%; height: 100%; background: linear-gradient(90deg, var(--gold), var(--gold2)); transform-origin: left center; }
      #flash { position: absolute; inset: 0; background: var(--gold2); opacity: 0; pointer-events: none; }

      /* scenes */
      .clip { position: absolute; inset: 0; }
      .stage { position: absolute; inset: 0; transform-origin: 470px 900px; }
      .stk { filter: var(--sticker); }
      .chip { position: absolute; left: 60px; top: 190px; height: 66px; padding: 0 26px; border-radius: 33px; background: #fff; border: 3px solid var(--gold); color: var(--brown);
        font-family: "Cinzel"; font-weight: 900; font-size: 30px; letter-spacing: 0.12em; display: flex; align-items: center; gap: 14px; box-shadow: 0 8px 14px rgba(74, 46, 26, 0.15); }
      .chip i { display: block; width: 14px; height: 14px; background: var(--gold); transform: rotate(45deg); }
      .chip.alt { background: var(--blue); border-color: #fff; color: #fff; }
      .chip.alt i { background: #fff; }
      .headline { position: absolute; left: 60px; top: 285px; width: 860px; font-family: "Cinzel"; font-weight: 900; font-size: 88px; line-height: 1.08; text-transform: uppercase; color: var(--brown); }
      .headline .hl { display: block; overflow: hidden; padding-bottom: 8px; }
      .headline .hw { display: inline-block; }
      .headline .y { font-family: "Dancing Script"; font-weight: 700; font-size: 1.62em; line-height: 0.95; text-transform: none; color: var(--blue); }
      .headline .sm { font-size: 62px; letter-spacing: 0.04em; color: var(--brown2); }
      .visual { position: absolute; left: 40px; top: 690px; width: 880px; height: 640px; }
      .center { display: flex; align-items: center; justify-content: center; }

      .lab { display: flex; align-items: center; gap: 22px; height: 70px; white-space: nowrap; padding: 0 28px; border-radius: 38px; background: #fff; border: 3px solid var(--gold2); box-shadow: 0 10px 16px rgba(74, 46, 26, 0.13);
        font-family: "Cinzel"; font-weight: 900; font-size: 40px; text-transform: uppercase; color: var(--brown); }
      .lab i { display: block; width: 38px; height: 38px; border-radius: 50%; }
      .tag { position: absolute; }
      .pillow { position: absolute; width: 520px; height: 340px; }

      /* 1 question */
      #q-pillow { left: 40px; top: 120px; }
      #q-cal { position: absolute; left: 560px; top: 20px; width: 280px; height: 300px; }
      #q-mark { position: absolute; left: 640px; top: 350px; width: 150px; height: 150px; border-radius: 50%; background: var(--blue); color: #fff; font-family: "Dancing Script"; font-weight: 700; font-size: 120px; }

      /* 2 rest: pillow + night clock */
      #r-pillow { left: 30px; top: 230px; }
      #r-moon { position: absolute; left: 60px; top: 0; width: 180px; height: 180px; }
      #r-clock { position: absolute; left: 540px; top: 20px; width: 300px; height: 300px; }

      /* 3 build-up */
      #b-pillow { left: 180px; top: 20px; }
      .bl { position: absolute; }
      #bl-1 { left: 20px; top: 400px; } #bl-2 { left: 470px; top: 400px; } #bl-3 { left: 20px; top: 500px; } #bl-4 { left: 470px; top: 500px; }

      /* 4 weekly: calendar */
      #cal { position: absolute; left: 120px; top: 20px; width: 640px; height: 460px; }
      #w-once { position: absolute; left: 140px; top: 500px; }

      /* 5 sooner: dirty -> clean */
      #d-pillow { left: 10px; top: 140px; transform-origin: 50% 50%; width: 360px; height: 236px; }
      #c-pillow { left: 510px; top: 140px; width: 360px; height: 236px; }
      #swap { position: absolute; left: 380px; top: 200px; width: 120px; height: 120px; }
      #s-dirty { left: 20px; top: 430px; } #s-sweat { left: 480px; top: 430px; }

      /* 6 care label + dry */
      #care-tag { position: absolute; left: 90px; top: 20px; width: 360px; height: 480px; }
      #dry-sun { position: absolute; left: 520px; top: 60px; width: 300px; height: 300px; }
      #c-dry { left: 400px; top: 400px; }

      /* 7 detergent */
      #jug { position: absolute; left: 90px; top: 20px; width: 340px; height: 500px; }
      #d-sens { left: 470px; top: 90px; } #d-nofrag { left: 470px; top: 200px; }
      #nofrag-ic { position: absolute; left: 560px; top: 320px; width: 200px; height: 200px; }

      /* 8 caveat: one piece of the care puzzle */
      #puzzle { position: absolute; left: 220px; top: 0; width: 440px; height: 440px; }
      #cv-no { left: 0; top: 470px; } #cv-part { left: 500px; top: 470px; }

      /* 9 spare */
      #sp-1 { left: 60px; top: 170px; width: 460px; height: 300px; }
      #sp-2 { left: 120px; top: 90px; width: 460px; height: 300px; }
      #sp-num { position: absolute; left: 610px; top: 60px; width: 240px; font-family: "Dancing Script"; font-weight: 700; font-size: 230px; line-height: 0.9; color: var(--blue); text-align: center; }
      #sp-easy { left: 560px; top: 420px; }

      /* 10 cta */
      #cta-pillow { left: 180px; top: 60px; }
      #sparkles { position: absolute; left: 150px; top: 20px; width: 580px; height: 400px; }
      #share { position: absolute; left: 20px; top: 470px; width: 840px; height: 130px; border-radius: 65px; background: var(--blue); gap: 20px; color: #fff; font-family: "Cinzel"; font-weight: 900; font-size: 36px; letter-spacing: 0.04em; text-transform: uppercase; }
      #share-arrow { display: block; width: 64px; height: 64px; }
      #tiktok { display: block; flex: 0 0 76px; width: 76px; height: 76px; border-radius: 17px; box-shadow: 0 0 0 4px #fff; }

      /* captions: word-by-word, on a white sticker label */
      #caps { position: absolute; left: 60px; top: 1370px; width: 840px; height: 190px; }
      .cap-line { position: absolute; left: 0; top: 0; width: 840px; text-align: center; opacity: 0; }
      .cap-pill { display: inline-block; max-width: 840px; padding: 14px 30px 18px; border-radius: 30px; background: #fff; border: 3px solid var(--gold2); box-shadow: 0 10px 18px rgba(74, 46, 26, 0.16);
        font-weight: 700; font-size: 60px; line-height: 1.15; }
      .cw { display: inline-block; margin: 0 8px; color: var(--brown); }
    </style>
  </head>
  <body>
    <div id="root" data-composition-id="main" data-start="0" data-duration="%TOTAL%" data-width="1080" data-height="1920">
      <div id="bg"></div>
      <div id="weave"></div>
      <div id="band"></div>
      <svg width="0" height="0" style="position: absolute">
        <defs>
          <radialGradient id="skin-g" cx="40%" cy="35%"><stop offset="0" stop-color="#c99470" /><stop offset=".7" stop-color="#a86f4a" /><stop offset="1" stop-color="#8d5a3b" /></radialGradient>
          <radialGradient id="zit-g" cx="45%" cy="40%"><stop offset="0" stop-color="#fff6e6" /><stop offset=".28" stop-color="#fff0d6" /><stop offset=".32" stop-color="#d9745a" /><stop offset="1" stop-color="#b8452f" /></radialGradient>
          <radialGradient id="crater-g" cx="50%" cy="45%"><stop offset="0" stop-color="#5c3520" /><stop offset=".6" stop-color="#7a4a2f" /><stop offset=".85" stop-color="#9a6444" /><stop offset="1" stop-color="#c99470" /></radialGradient>
          <radialGradient id="swell-g"><stop offset="0" stop-color="#b8452f" stop-opacity=".75" /><stop offset="1" stop-color="#b8452f" stop-opacity="0" /></radialGradient>
          <filter id="soft"><feGaussianBlur stdDeviation="9" /></filter>
        </defs>
      </svg>
      <svg width="0" height="0" style="position: absolute">
        <defs>
          <symbol id="pillow-art" viewBox="0 0 520 340">
            <path d="M40 60 Q260 20 480 60 Q510 170 480 280 Q260 320 40 280 Q10 170 40 60Z" fill="#ffffff" stroke="#efe4d2" stroke-width="4" />
            <path d="M40 60 Q260 20 480 60 L486 110 Q260 72 34 110 Z" fill="#2f6fd0" />
            <path d="M34 110 Q260 72 486 110" fill="none" stroke="#c9a24b" stroke-width="6" />
            <path d="M40 90 L60 72 L80 88 L100 70 L120 86 L140 68 L160 84 L180 66 L200 82 L220 64 L240 80 L260 62 L280 80 L300 64 L320 82 L340 66 L360 84 L380 68 L400 86 L420 70 L440 88 L460 72 L480 90" fill="none" stroke="#ffffff" stroke-width="4" opacity=".8" />
            <path d="M120 200 Q260 180 400 200" fill="none" stroke="#efe4d2" stroke-width="5" stroke-linecap="round" />
          </symbol>
          <symbol id="stains-art" viewBox="0 0 520 340">
            <g filter="url(#soft)"><ellipse cx="200" cy="200" rx="60" ry="36" fill="#c9a24b" opacity=".55" /><ellipse cx="340" cy="230" rx="44" ry="28" fill="#8a5a36" opacity=".45" /><ellipse cx="300" cy="150" rx="30" ry="20" fill="#a86f4a" opacity=".4" /></g>
          </symbol>
          <symbol id="check-art" viewBox="0 0 38 30"><path d="M4 16 L14 26 L34 4" fill="none" stroke="#fff" stroke-width="7" stroke-linecap="round" stroke-linejoin="round" /></symbol>
        </defs>
      </svg>

      <!-- 1. QUESTION -->
      <section id="s-q" class="clip" data-start="%q.start%" data-duration="%q.dur%" data-track-index="1">
        <div class="stage">
          <div class="chip alt"><i></i>SU'AAL<i></i></div>
          <div class="headline"><span class="hl"><span class="hw y">Galka</span> <span class="hw y">barkinta</span></span><span class="hl sm"><span class="hw">goormaad</span> <span class="hw">beddeshay?</span></span></div>
          <div class="visual">
            <svg class="pillow stk" id="q-pillow" viewBox="0 0 520 340"><use href="#pillow-art" width="520" height="340" /></svg>
            <svg id="q-cal" class="stk" viewBox="0 0 280 300"><rect x="10" y="30" width="260" height="260" rx="28" fill="#ffffff" /><rect x="10" y="30" width="260" height="70" rx="28" fill="#b8452f" /><rect x="10" y="70" width="260" height="30" fill="#b8452f" /><rect x="60" y="10" width="20" height="50" rx="10" fill="#4a2e1a" /><rect x="200" y="10" width="20" height="50" rx="10" fill="#4a2e1a" /><text x="140" y="230" text-anchor="middle" font-family="Cinzel" font-weight="900" font-size="110" fill="#4a2e1a">?</text></svg>
            <div id="q-mark" class="center stk">?</div>
          </div>
        </div>
      </section>

      <!-- 2. REST -->
      <section id="s-rest" class="clip" data-start="%rest.start%" data-duration="%rest.dur%" data-track-index="1">
        <div class="stage">
          <div class="chip"><i></i>XAQIIQ<i></i></div>
          <div class="headline"><span class="hl"><span class="hw y">Saacado</span> <span class="hw y">badan</span></span><span class="hl sm"><span class="hw">habeen</span> <span class="hw">kasta</span></span></div>
          <div class="visual">
            <svg id="r-moon" class="stk" viewBox="0 0 200 200"><path d="M130 20 A80 80 0 1 0 180 130 A64 64 0 1 1 130 20Z" fill="#1c3f86" /><path d="M150 40 l5 12 12 5 -12 5 -5 12 -5 -12 -12 -5 12 -5z" fill="#e3c173" /></svg>
            <svg class="pillow stk" id="r-pillow" viewBox="0 0 520 340"><use href="#pillow-art" width="520" height="340" /></svg>
            <svg id="r-clock" class="stk" viewBox="0 0 300 300"><circle cx="150" cy="150" r="140" fill="#ffffff" stroke="#c9a24b" stroke-width="12" /><g fill="#4a2e1a"><circle cx="150" cy="30" r="7" /><circle cx="270" cy="150" r="7" /><circle cx="150" cy="270" r="7" /><circle cx="30" cy="150" r="7" /></g><g id="hand-h"><path d="M150 150 L150 80" stroke="#4a2e1a" stroke-width="14" stroke-linecap="round" /></g><g id="hand-m"><path d="M150 150 L220 150" stroke="#2f6fd0" stroke-width="10" stroke-linecap="round" /></g><circle cx="150" cy="150" r="12" fill="#b8452f" /></svg>
          </div>
        </div>
      </section>

      <!-- 3. BUILD-UP -->
      <section id="s-buildup" class="clip" data-start="%buildup.start%" data-duration="%buildup.dur%" data-track-index="1">
        <div class="stage">
          <div class="chip alt"><i></i>KHATAR<i></i></div>
          <div class="headline"><span class="hl"><span class="hw y">Dhidid</span></span><span class="hl sm"><span class="hw">saliid</span> <span class="hw">iyo</span> <span class="hw">unugyo</span></span></div>
          <div class="visual">
            <svg class="pillow stk" id="b-pillow" viewBox="0 0 520 340"><use href="#pillow-art" width="520" height="340" />
              <g id="bp-sweat" fill="#6fa4e8"><path d="M160 150 C168 168 180 176 180 190 C180 202 171 210 160 210 C149 210 140 202 140 190 C140 176 152 168 160 150Z" /><path d="M380 210 C386 224 395 230 395 241 C395 250 388 256 380 256 C372 256 365 250 365 241 C365 230 374 224 380 210Z" /></g>
              <g id="bp-oil" fill="#c9a24b" opacity=".75"><ellipse cx="270" cy="170" rx="26" ry="16" /><ellipse cx="220" cy="250" rx="18" ry="11" /></g>
              <g id="bp-cells" fill="#8a5a36"><rect x="320" y="150" width="16" height="7" rx="3" transform="rotate(-20 328 153)" /><rect x="120" y="240" width="16" height="7" rx="3" transform="rotate(25 128 243)" /><rect x="300" y="260" width="14" height="6" rx="3" /><rect x="190" y="200" width="14" height="6" rx="3" transform="rotate(40 197 203)" /></g>
              <g id="bp-hair" fill="none" stroke="#2a1a10" stroke-width="3" stroke-linecap="round"><path d="M350 120 Q380 140 360 170 Q340 200 372 220" /><path d="M110 140 Q130 170 112 200" /></g>
            </svg>
            <div class="lab bl" id="bl-1"><i style="background: #6fa4e8"></i>Dhidid</div>
            <div class="lab bl" id="bl-2"><i style="background: var(--gold)"></i>Saliid</div>
            <div class="lab bl" id="bl-3"><i style="background: var(--brown2)"></i>Unugyo</div>
            <div class="lab bl" id="bl-4"><i style="background: #2a1a10"></i>Timaha</div>
          </div>
        </div>
      </section>

      <!-- 4. WEEKLY -->
      <section id="s-weekly" class="clip" data-start="%weekly.start%" data-duration="%weekly.dur%" data-track-index="1">
        <div class="stage">
          <div class="chip"><i></i>TALLAABO 1<i></i></div>
          <div class="headline"><span class="hl"><span class="hw y">Toddobaadkii</span></span><span class="hl sm"><span class="hw">hal</span> <span class="hw">mar</span></span></div>
          <div class="visual">
            <svg id="cal" class="stk" viewBox="0 0 640 460">
              <rect x="10" y="10" width="620" height="440" rx="36" fill="#ffffff" />
              <rect x="10" y="10" width="620" height="90" rx="36" fill="#2f6fd0" /><rect x="10" y="60" width="620" height="40" fill="#2f6fd0" />
              <g fill="#efe4d2"><rect x="40" y="130" width="70" height="70" rx="14" /><rect x="125" y="130" width="70" height="70" rx="14" /><rect x="210" y="130" width="70" height="70" rx="14" /><rect x="295" y="130" width="70" height="70" rx="14" /><rect x="380" y="130" width="70" height="70" rx="14" /><rect x="465" y="130" width="70" height="70" rx="14" /><rect x="550" y="130" width="60" height="70" rx="14" /></g>
              <g fill="#efe4d2"><rect x="40" y="225" width="70" height="70" rx="14" /><rect x="125" y="225" width="70" height="70" rx="14" /><rect x="210" y="225" width="70" height="70" rx="14" /><rect x="295" y="225" width="70" height="70" rx="14" /><rect x="380" y="225" width="70" height="70" rx="14" /><rect x="465" y="225" width="70" height="70" rx="14" /><rect x="550" y="225" width="60" height="70" rx="14" /></g>
              <g fill="#efe4d2"><rect x="40" y="320" width="70" height="70" rx="14" /><rect x="125" y="320" width="70" height="70" rx="14" /><rect x="210" y="320" width="70" height="70" rx="14" /><rect x="295" y="320" width="70" height="70" rx="14" /><rect x="380" y="320" width="70" height="70" rx="14" /><rect x="465" y="320" width="70" height="70" rx="14" /><rect x="550" y="320" width="60" height="70" rx="14" /></g>
              <g class="wk" fill="#c9a24b"><rect x="550" y="130" width="60" height="70" rx="14" /></g>
              <g class="wk" fill="#c9a24b"><rect x="550" y="225" width="60" height="70" rx="14" /></g>
              <g class="wk" fill="#c9a24b"><rect x="550" y="320" width="60" height="70" rx="14" /></g>
            </svg>
            <div class="lab tag" id="w-once"><i style="background: var(--gold)"></i>Hal mar toddobaadkii</div>
          </div>
        </div>
      </section>

      <!-- 5. SOONER -->
      <section id="s-sooner" class="clip" data-start="%sooner.start%" data-duration="%sooner.dur%" data-track-index="1">
        <div class="stage">
          <div class="chip"><i></i>TALLAABO 2<i></i></div>
          <div class="headline"><span class="hl"><span class="hw y">Beddel</span></span><span class="hl sm"><span class="hw">haddii</span> <span class="hw">uu</span> <span class="hw">wasakhoobo</span></span></div>
          <div class="visual">
            <svg class="pillow stk" id="d-pillow" viewBox="0 0 520 340"><use href="#pillow-art" width="520" height="340" /><use id="d-stains" href="#stains-art" width="520" height="340" /></svg>
            <svg id="swap" viewBox="0 0 120 120"><path d="M14 44 H96 M76 20 L100 44 L76 68" fill="none" stroke="#2f6fd0" stroke-width="12" stroke-linecap="round" stroke-linejoin="round" /><path d="M106 84 H24 M44 60 L20 84 L44 108" fill="none" stroke="#c9a24b" stroke-width="12" stroke-linecap="round" stroke-linejoin="round" /></svg>
            <svg class="pillow stk" id="c-pillow" viewBox="0 0 520 340"><use href="#pillow-art" width="520" height="340" /></svg>
            <div class="lab tag" id="s-dirty"><i style="background: var(--brown2)"></i>Wasakh</div>
            <div class="lab tag" id="s-sweat"><i style="background: #6fa4e8"></i>Dhidid badan</div>
          </div>
        </div>
      </section>

      <!-- 6. CARE LABEL -->
      <section id="s-care" class="clip" data-start="%care.start%" data-duration="%care.dur%" data-track-index="1">
        <div class="stage">
          <div class="chip"><i></i>TALLAABO 3<i></i></div>
          <div class="headline"><span class="hl"><span class="hw y">Raac</span></span><span class="hl sm"><span class="hw">tilmaamaha</span> <span class="hw">dhaqidda</span></span></div>
          <div class="visual">
            <svg id="care-tag" class="stk" viewBox="0 0 360 480">
              <path d="M40 20 H320 V440 L180 470 L40 440 Z" fill="#ffffff" stroke="#efe4d2" stroke-width="4" />
              <circle cx="180" cy="56" r="14" fill="#efe4d2" />
              <g fill="none" stroke="#4a2e1a" stroke-width="8" stroke-linejoin="round" stroke-linecap="round">
                <path d="M90 110 L104 190 H176 L190 110" /><path d="M86 120 Q110 104 134 120 T186 120" />
                <path d="M230 190 L270 110 L310 190 Z" />
                <rect x="90" y="250" width="90" height="90" rx="8" /><circle cx="135" cy="295" r="30" />
                <path d="M230 300 L270 250 L310 300 M240 330 H300" />
              </g>
              <text x="140" y="172" text-anchor="middle" font-family="Cinzel" font-weight="900" font-size="30" fill="#2f6fd0">30°</text>
              <path d="M90 390 H270 M90 412 H230" stroke="#c9a24b" stroke-width="6" stroke-linecap="round" />
            </svg>
            <svg id="dry-sun" class="stk" viewBox="0 0 300 300"><circle cx="150" cy="150" r="140" fill="#ffffff" /><circle cx="150" cy="130" r="46" fill="#e3c173" /><g stroke="#c9a24b" stroke-width="10" stroke-linecap="round"><path d="M150 50v22M150 188v22M70 130h22M208 130h22M93 73l15 15M192 172l15 15M93 187l15-15M192 88l15-15" /></g><path d="M70 240 Q110 220 150 240 T230 240" fill="none" stroke="#6fa4e8" stroke-width="8" stroke-linecap="round" /></svg>
            <div class="lab tag" id="c-dry"><i style="background: var(--gold)"></i>Si fiican u qalaji</div>
          </div>
        </div>
      </section>

      <!-- 7. DETERGENT -->
      <section id="s-detergent" class="clip" data-start="%detergent.start%" data-duration="%detergent.dur%" data-track-index="1">
        <div class="stage">
          <div class="chip"><i></i>TALLAABO 4<i></i></div>
          <div class="headline"><span class="hl"><span class="hw y">Aan</span> <span class="hw y">caraf</span> <span class="hw y">lahayn</span></span><span class="hl sm"><span class="hw">saabuunta</span> <span class="hw">dharka</span></span></div>
          <div class="visual">
            <svg id="jug" class="stk" viewBox="0 0 340 500">
              <rect x="130" y="10" width="90" height="56" rx="12" fill="#1c3f86" />
              <path d="M40 110 Q40 70 90 70 H250 Q300 70 300 120 V450 Q300 490 260 490 H80 Q40 490 40 450 Z" fill="#fffaf1" stroke="#efe4d2" stroke-width="4" />
              <path d="M250 110 Q300 110 300 170 V240 Q300 260 280 260 Q260 260 260 240 V170 Q260 140 240 140" fill="none" stroke="#efe4d2" stroke-width="16" />
              <rect x="40" y="200" width="260" height="190" fill="#2f6fd0" />
              <path d="M170 216 l7 21 h22 l-18 13 7 21 -18 -13 -18 13 7 -21 -18 -13 h22 z" fill="#ffffff" />
              <text x="170" y="328" text-anchor="middle" font-family="Cinzel" font-weight="900" font-size="34" fill="#ffffff">SAABUUN</text>
              <text x="170" y="366" text-anchor="middle" font-family="Cinzel" font-weight="900" font-size="26" fill="#e3c173">DHARKA</text>
            </svg>
            <div class="lab tag" id="d-sens"><i style="background: var(--terra)"></i>Maqaar xasaasi</div>
            <div class="lab tag" id="d-nofrag"><i style="background: var(--blue)"></i>Caraf la'aan</div>
            <svg id="nofrag-ic" class="stk" viewBox="0 0 200 200"><circle cx="100" cy="100" r="92" fill="#ffffff" /><rect x="80" y="36" width="40" height="28" rx="6" fill="#c9a24b" /><path d="M60 90 Q60 64 86 64 H114 Q140 64 140 90 V148 Q140 168 120 168 H80 Q60 168 60 148 Z" fill="#e0a8a0" /><g fill="none" stroke="#b8452f" stroke-width="16"><circle cx="100" cy="100" r="80" /><path d="M43 43 L157 157" /></g></svg>
          </div>
        </div>
      </section>

      <!-- 8. CAVEAT -->
      <section id="s-caveat" class="clip" data-start="%caveat.start%" data-duration="%caveat.dur%" data-track-index="1">
        <div class="stage">
          <div class="chip"><i></i>XAQIIQ<i></i></div>
          <div class="headline"><span class="hl"><span class="hw y">Nadaafad</span></span><span class="hl sm"><span class="hw">waa</span> <span class="hw">qayb</span> <span class="hw">daryeelka</span></span></div>
          <div class="visual">
            <svg id="puzzle" class="stk" viewBox="0 0 440 440">
              <g class="pz"><rect x="10" y="10" width="200" height="200" rx="26" fill="#ffffff" stroke="#efe4d2" stroke-width="4" /><path d="M80 110 Q110 70 150 95" fill="none" stroke="#6fa4e8" stroke-width="12" stroke-linecap="round" /><circle cx="110" cy="135" r="24" fill="#6fa4e8" /></g>
              <g class="pz"><rect x="230" y="10" width="200" height="200" rx="26" fill="#ffffff" stroke="#efe4d2" stroke-width="4" /><rect x="285" y="60" width="90" height="110" rx="18" fill="#2f6fd0" /><rect x="295" y="45" width="70" height="24" rx="8" fill="#c9a24b" /></g>
              <g class="pz"><rect x="10" y="230" width="200" height="200" rx="26" fill="#ffffff" stroke="#efe4d2" stroke-width="4" /><path d="M85 280 H135 V320 H175 V370 H135 V410 H85 V370 H45 V320 H85Z" fill="#2f6fd0" /></g>
              <g id="pz-pillow"><rect x="230" y="230" width="200" height="200" rx="26" fill="#e3c173" stroke="#c9a24b" stroke-width="6" /><use href="#pillow-art" x="245" y="275" width="170" height="111" /></g>
            </svg>
            <div class="lab tag" id="cv-no"><i style="background: var(--terra)"></i>Daawo ma aha</div>
            <div class="lab tag" id="cv-part"><i style="background: var(--gold)"></i>Waa qayb</div>
          </div>
        </div>
      </section>

      <!-- 9. SPARE -->
      <section id="s-spare" class="clip" data-start="%spare.start%" data-duration="%spare.dur%" data-track-index="1">
        <div class="stage">
          <div class="chip"><i></i>TALLAABO 5<i></i></div>
          <div class="headline"><span class="hl"><span class="hw y">Gal</span> <span class="hw y">labaad</span></span><span class="hl sm"><span class="hw">diyaarso</span></span></div>
          <div class="visual">
            <svg class="pillow stk" id="sp-1" viewBox="0 0 520 340"><use href="#pillow-art" width="520" height="340" /></svg>
            <svg class="pillow stk" id="sp-2" viewBox="0 0 520 340"><use href="#pillow-art" width="520" height="340" /></svg>
            <div id="sp-num">2</div>
            <div class="lab tag" id="sp-easy"><i style="background: var(--blue)"></i>Fudud</div>
          </div>
        </div>
      </section>

      <!-- 10. CTA -->
      <section id="s-cta" class="clip" data-start="%cta.start%" data-duration="%cta.dur%" data-track-index="1">
        <div class="stage">
          <div class="chip"><i></i>CAAWA<i></i></div>
          <div class="headline"><span class="hl"><span class="hw y">Gal</span> <span class="hw y">nadiif</span> <span class="hw y">ah!</span></span><span class="hl sm"><span class="hw">barkintaada</span> <span class="hw">u</span> <span class="hw">geli</span></span></div>
          <div class="visual">
            <svg class="pillow stk" id="cta-pillow" viewBox="0 0 520 340"><use href="#pillow-art" width="520" height="340" /></svg>
            <svg id="sparkles" viewBox="0 0 580 400"><g fill="#c9a24b"><path class="spk" d="M60 60 l10 24 24 10 -24 10 -10 24 -10 -24 -24 -10 24 -10z" /><path class="spk" d="M520 90 l8 18 18 8 -18 8 -8 18 -8 -18 -18 -8 18 -8z" /><path class="spk" d="M500 330 l10 24 24 10 -24 10 -10 24 -10 -24 -24 -10 24 -10z" /><path class="spk" d="M40 320 l7 16 16 7 -16 7 -7 16 -7 -16 -16 -7 16 -7z" /></g></svg>
            <div id="share" class="center stk"><svg id="tiktok" viewBox="0 0 48 48"><rect width="48" height="48" rx="11" fill="#000000" /><g transform="translate(7.8 7.8) scale(1.35)"><path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.650-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z" fill="#25f4ee" transform="translate(-0.9 -0.9)" /><path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.650-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z" fill="#fe2c55" transform="translate(0.9 0.9)" /><path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.650-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z" fill="#ffffff" /></g></svg><span>U dir qof aad jeceshahay</span><svg id="share-arrow" viewBox="0 0 64 64"><path d="M36 10 L58 30 L36 50 V38 C22 38 12 42 6 54 C8 34 18 24 36 22 Z" fill="#ffffff" /></svg></div>
          </div>
        </div>
      </section>

      <!-- persistent chrome above scenes -->
      <div id="brand"><svg width="30" height="28" viewBox="0 0 46 42"><path d="M23 40 C8 28 2 20 2 12 C2 6 7 2 12 2 C17 2 21 5 23 9 C25 5 29 2 34 2 C39 2 44 6 44 12 C44 20 38 28 23 40Z" fill="#2f6fd0" /></svg>BARKINTA &amp; MAQAARKA</div>
      <div id="prog"><span id="prog-fill"></span></div>
      <div id="caps">
        %CAPTIONS%
      </div>
      <div id="flash"></div>

    %AUDIO%
    </div>
    <script>
      const D = %DATA%;
      const tl = gsap.timeline({ paused: true });
      const S = {};
      D.scenes.forEach((s) => (S[s.id] = s));
      const B = D.beats;
      const q = (sel) => document.querySelector(sel);
      const pop = (sel, t, from = 0.3) => tl.fromTo(sel, { scale: from, opacity: 0 }, { scale: 1, opacity: 1, duration: 0.35, ease: "back.out(2.4)" }, t);

      // persistent theme motion: the woven lattice and patterned band drift slowly, progress fills
      tl.fromTo("#weave", { backgroundPosition: "0px 0px" }, { backgroundPosition: "0px 220px", duration: D.total, ease: "none" }, 0);
      tl.fromTo("#band", { backgroundPosition: "0px 0px" }, { backgroundPosition: "220px 0px", duration: D.total, ease: "none" }, 0);
      tl.fromTo("#prog-fill", { scaleX: 0 }, { scaleX: 1, duration: D.total, ease: "none" }, 0);

      // every scene: hard cut + gold flash, punch-in landing, a mid-scene jump-cut zoom
      D.scenes.forEach((s, i) => {
        const el = q("#s-" + s.id);
        const stage = el.querySelector(".stage");
        const dir = i % 2 ? -1 : 1;
        tl.fromTo(stage, { scale: 1.16, x: 90 * dir }, { scale: 1, x: 0, duration: 0.38, ease: "power3.out" }, s.start);
        const jump = s.start + s.dur * 0.56;
        tl.set(stage, { scale: 1.07 }, jump);
        tl.to(stage, { scale: 1.1, duration: s.dur * 0.44 - 0.02, ease: "none" }, jump + 0.01);
        if (i > 0) {
          tl.set("#flash", { opacity: 0.55 }, s.start);
          tl.to("#flash", { opacity: 0, duration: 0.16, ease: "power2.out" }, s.start + 0.001);
        }
        tl.fromTo(el.querySelector(".chip"), { scale: 0.4, opacity: 0 }, { scale: 1, opacity: 1, duration: 0.3, ease: "back.out(3)" }, s.start + 0.05);
        tl.fromTo(el.querySelectorAll(".hw"), { yPercent: 105 }, { yPercent: 0, duration: 0.42, stagger: 0.06, ease: "power4.out" }, s.start + 0.08);
      });

      // 1 question
      pop("#q-pillow", S.q.start + 0.15);
      pop("#q-cal", S.q.start + 0.4);
      tl.fromTo("#q-mark", { scale: 0, rotation: -30 }, { scale: 1, rotation: 8, duration: 0.35, ease: "back.out(3)" }, B.ask);

      // 2 rest: night, hours pass on the clock
      pop("#r-moon", S.rest.start + 0.1);
      tl.fromTo("#r-pillow", { y: 300, opacity: 0 }, { y: 0, opacity: 1, duration: 0.4, ease: "power3.out" }, S.rest.start + 0.2);
      pop("#r-clock", B.night);
      tl.fromTo("#hand-m", { rotation: 0, svgOrigin: "150 150" }, { rotation: 720, svgOrigin: "150 150", duration: 1.6, ease: "power1.inOut" }, B.hours);
      tl.fromTo("#hand-h", { rotation: 0, svgOrigin: "150 150" }, { rotation: 240, svgOrigin: "150 150", duration: 1.6, ease: "power1.inOut" }, B.hours);

      // 3 build-up: each thing lands on the pillow with its word
      pop("#b-pillow", S.buildup.start + 0.15);
      [["#bp-sweat", "#bl-1", B.sweat], ["#bp-oil", "#bl-2", B.oil], ["#bp-cells", "#bl-3", B.cells], ["#bp-hair", "#bl-4", B.hair]].forEach(([part, lab, t]) => {
        tl.fromTo(part, { opacity: 0, scale: 0.3, transformOrigin: "50% 50%" }, { opacity: 1, scale: 1, duration: 0.3, ease: "back.out(3)" }, t);
        pop(lab, t);
      });

      // 4 weekly: calendar, one day per week lights up
      pop("#cal", S.weekly.start + 0.15);
      tl.fromTo(".wk", { opacity: 0 }, { opacity: 1, duration: 0.2, stagger: 0.18 }, B.week);
      pop("#w-once", B.week + 0.3);

      // 5 sooner: stains appear, swap for a clean one
      pop("#d-pillow", S.sooner.start + 0.15);
      tl.fromTo("#d-stains", { opacity: 0 }, { opacity: 1, duration: 0.4 }, B.dirty);
      pop("#s-dirty", B.dirty);
      pop("#s-sweat", B.dirty + 0.7);
      pop("#swap", B.swap - 0.15);
      tl.fromTo("#c-pillow", { x: 300, opacity: 0 }, { x: 0, opacity: 1, duration: 0.35, ease: "back.out(1.8)" }, B.swap);

      // 6 care label + dry well
      tl.fromTo("#care-tag", { y: 500, rotation: 10 }, { y: 0, rotation: -3, duration: 0.45, ease: "back.out(1.5)" }, B.tag - 0.15);
      pop("#dry-sun", B.dry - 0.3);
      pop("#c-dry", B.dry);

      // 7 detergent
      tl.fromTo("#jug", { y: 600 }, { y: 0, duration: 0.45, ease: "back.out(1.4)" }, S.detergent.start + 0.15);
      pop("#d-sens", B.sensitive);
      pop("#d-nofrag", B.nofrag - 0.05);
      pop("#nofrag-ic", B.nofrag + 0.1);

      // 8 caveat: not a cure, but one piece of care
      tl.fromTo(".pz", { opacity: 0, scale: 0.4, transformOrigin: "50% 50%" }, { opacity: 1, scale: 1, duration: 0.3, stagger: 0.1, ease: "back.out(2.5)" }, S.caveat.start + 0.2);
      tl.fromTo("#pz-pillow", { opacity: 0, x: 120, y: 120 }, { opacity: 1, x: 0, y: 0, duration: 0.4, ease: "back.out(1.8)" }, B.part - 0.2);
      pop("#cv-no", B.nocure);
      pop("#cv-part", B.part);

      // 9 spare pillowcase
      pop("#sp-1", S.spare.start + 0.15);
      pop("#sp-2", B.second);
      pop("#sp-num", B.second + 0.1);
      pop("#sp-easy", B.easy);

      // 10 cta: clean pillow sparkles, share
      pop("#cta-pillow", S.cta.start + 0.15);
      tl.fromTo(".spk", { scale: 0, opacity: 0, transformOrigin: "50% 50%" }, { scale: 1, opacity: 1, duration: 0.3, stagger: 0.1, ease: "back.out(3)" }, B.clean);
      tl.fromTo("#share", { y: 240, opacity: 0 }, { y: 0, opacity: 1, duration: 0.35, ease: "back.out(2)" }, B.share - 0.1);
      tl.fromTo("#tiktok", { scale: 0, rotation: -30 }, { scale: 1, rotation: 0, duration: 0.4, ease: "back.out(3)" }, B.share + 0.05);
      tl.fromTo("#share-arrow", { x: 0 }, { x: 14, duration: 0.25, yoyo: true, repeat: 3, ease: "sine.inOut" }, B.share + 0.3);

      // captions: word-by-word karaoke in Somali (active word in Somali blue)
      D.caps.forEach((g, gi) => {
        const line = "#cap-" + gi;
        tl.set(line, { opacity: 1 }, g.s);
        tl.fromTo(line, { scale: 0.86 }, { scale: 1, duration: 0.12, ease: "back.out(3)", immediateRender: false }, g.s);
        tl.set(line, { opacity: 0 }, g.e);
        g.w.forEach((w, wi) => {
          const id = "#cw-" + gi + "-" + wi;
          tl.set(id, { color: "#2f6fd0" }, w.s);
          if (wi + 1 < g.w.length) tl.set(id, { color: "#4a2e1a" }, g.w[wi + 1].s);
        });
      });

      window.__timelines["main"] = tl;
    </script>
  </body>
</html>
