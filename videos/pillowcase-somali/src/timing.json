{
 "scenes": [
  {
   "id": "q",
   "text": "Goormaad ugu dambaysay beddeshay galka barkintaada?",
   "s": 0.3,
   "e": 2.405
  },
  {
   "id": "rest",
   "text": "Habeen kasta wejigaagu saacado badan ayuu ku nastaa.",
   "s": 3.095,
   "e": 5.43
  },
  {
   "id": "buildup",
   "text": "Dhidid, saliid, unugyo maqaarka ka daatay, iyo waxyaabaha timaha la mariyo ayaa ku ururi kara.",
   "s": 6.12,
   "e": 10.401
  },
  {
   "id": "weekly",
   "text": "Sidaas darteed, galka barkinta dhaq oo beddel ugu yaraan toddobaadkii hal mar.",
   "s": 11.091,
   "e": 14.5
  },
  {
   "id": "sooner",
   "text": "Haddii uu wasakhoobo ama dhidid badan gaaro, ka sii hor beddel.",
   "s": 15.19,
   "e": 17.947
  },
  {
   "id": "care",
   "text": "Raac tilmaamaha dhaqidda ee ku qoran marada, si fiicanna u qalaji.",
   "s": 18.637,
   "e": 21.512
  },
  {
   "id": "detergent",
   "text": "Haddii maqaarkaagu xasaasi yahay, dooro saabuunta dharka oo aan caraf lahayn.",
   "s": 22.202,
   "e": 25.557
  },
  {
   "id": "caveat",
   "text": "Galka barkinta oo nadiif ahi keligiis ma daweeyo finanka, laakiin nadaafaddu waa qayb daryeelka ka mid ah.",
   "s": 26.247,
   "e": 31.036
  },
  {
   "id": "spare",
   "text": "Galka labaad diyaarso, si beddelku kuugu fududaado.",
   "s": 31.726,
   "e": 34.013
  },
  {
   "id": "cta",
   "text": "Caawa barkintaada u geli gal nadiif ah! U dir qof aad jeceshahay.",
   "s": 34.703,
   "e": 39.03
  }
 ],
