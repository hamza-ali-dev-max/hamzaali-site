{
 "scenes": [
  {
   "id": "q",
   "text": "Finku wuu tagay, laakiin bar madow ayuu kaa reebay?",
   "s": 0.3,
   "e": 3.087
  },
  {
   "id": "name",
   "text": "Taas waxaa la yiraahdaa madoobaadka finka ka dambeeya.",
   "s": 3.727,
   "e": 6.431
  },
  {
   "id": "why",
   "text": "Maqaarka madow wuxuu sameeyaa midab dheeraad ah marka uu xanaaqo.",
   "s": 7.071,
   "e": 10.488
  },
  {
   "id": "good",
   "text": "Warka wanaagsan: inta badan way yaraataa waqti ka dib.",
   "s": 11.128,
   "e": 13.884
  },
  {
   "id": "nopop",
   "text": "Ha tuujin finanka, maxaa yeelay taasi barta way sii madoojisaa.",
   "s": 14.524,
   "e": 17.923
  },
  {
   "id": "spf",
   "text": "Kareemka qorraxda maalin kasta mari, xitaa maalmaha daruurta leh.",
   "s": 18.563,
   "e": 21.754
  },
  {
   "id": "sun",
   "text": "Qorraxdu waxay barta ka dhigtaa mid sii madow oo muddo dheer jirta.",
   "s": 22.394,
   "e": 25.811
  },
  {
   "id": "ingr",
   "text": "Walxaha sida niacinamide, azelaic acid iyo retinoid ayaa caawin kara.",
   "s": 26.451,
   "e": 30.37
  },
  {
   "id": "avoid",
   "text": "Ka fogow xoqidda adag iyo kareemada cadeeya ee khatarta ah.",
   "s": 31.01,
   "e": 34.053
  },
  {
   "id": "doctor",
   "text": "Haddii bartu aysan yaraan, la tasho dhakhtarka maqaarka.",
   "s": 34.693,
   "e": 37.587
  },
  {
   "id": "cta",
   "text": "La wadaag qof u baahan taladan, lana soco Skincare by Ubah.",
   "s": 38.227,
   "e": 41.528
  }
 ],
