{
 "scenes": [
  {
   "id": "q",
   "text": "Adigoo wejiga qurxin ku leh ma seexataa?",
   "s": 0.3,
   "e": 2.297
  },
  {
   "id": "tired",
   "text": "Xitaa haddii aad daalan tahay, iska saar ka hor hurdada.",
   "s": 3.087,
   "e": 5.612
  },
  {
   "id": "pores",
   "text": "Qurxinta habeenkii wejiga ku hartaa waxay xiri kartaa daloolada maqaarka, waxayna keeni kartaa finan.",
   "s": 6.402,
   "e": 11.285
  },
  {
   "id": "remove",
   "text": "Marka hore, si tartiib ah uga saar qurxinta wejiga iyo indhaha.",
   "s": 12.075,
   "e": 15.207
  },
  {
   "id": "wash",
   "text": "Kadib wejiga ku dhaq nadiifiye jilicsan iyo biyo diirran.",
   "s": 15.997,
   "e": 18.776
  },
  {
   "id": "fingers",
   "text": "Farahaaga isticmaal, hana xoqin maqaarka.",
   "s": 19.566,
   "e": 21.585
  },
  {
   "id": "pat",
   "text": "Tuwaal nadiif ah si tartiib ah ugu qalaji.",
   "s": 22.375,
   "e": 24.52
  },
  {
   "id": "moist",
   "text": "Ugu dambayn, mari kareem qoyaan siiya maqaarkaaga oo aan daloolada xirin.",
   "s": 25.31,
   "e": 28.784
  },
  {
   "id": "share",
   "text": "Alaabta qurxinta iyo burushyada dadka kale ha la wadaagin.",
   "s": 29.574,
   "e": 32.211
  },
  {
   "id": "cta",
   "text": "Caawa caado fiican bilow: qurxinta iska saar, wejigaagana daryeel! U dir qof aad jeceshahay.",
   "s": 33.001,
   "e": 39.177
  }
 ],
