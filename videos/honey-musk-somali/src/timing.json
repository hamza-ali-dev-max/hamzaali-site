{
 "scenes": [
  {
   "id": "l1",
   "text": "Udgoon macaan oo kalsooni kugu dhex abuura!",
   "s": 0.3,
   "e": 2.81
  },
  {
   "id": "l2",
   "text": "Kani waa Honey Musk, Confidence Dose, oo ka socda Ibraq.",
   "s": 3.45,
   "e": 6.739
  },
  {
   "id": "l3",
   "text": "Waa cadar tayo sare leh, toddobaatan iyo shan mililitir, ragga iyo dumarkaba.",
   "s": 7.379,
   "e": 12.229
  },
  {
   "id": "l4",
   "text": "Wuxuu ku bilaabmaa sacfaraan, malab iyo liin macaan.",
   "s": 12.869,
   "e": 15.716
  },
  {
   "id": "l5",
   "text": "Wadnihiisu waa ubaxa plumeria, bun iyo tonka.",
   "s": 16.356,
   "e": 19.428
  },
  {
   "id": "l6",
   "text": "Salkiisuna waa vanilla, tubaako iyo misk.",
   "s": 20.068,
   "e": 22.665
  },
  {
   "id": "l7",
   "text": "Waa udgoon diirran oo macaan, oo dadka kuu soo jiidanaya.",
   "s": 23.305,
   "e": 26.998
  },
  {
   "id": "l8",
   "text": "Waxaad ka heli kartaa Falarosa Luxury, Surrey, BC, Kanada.",
   "s": 27.638,
   "e": 31.763
  },
  {
   "id": "l9",
   "text": "Nagala soo xiriir lambarka ku qoran bogga.",
   "s": 32.403,
   "e": 34.593
  },
  {
   "id": "l10",
   "text": "Honey Musk, Ibraq. Hadda dalbo!",
   "s": 35.233,
   "e": 37.751
  }
 ],
