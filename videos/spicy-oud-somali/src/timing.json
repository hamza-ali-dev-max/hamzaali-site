{
 "scenes": [
  {
   "id": "l1",
   "text": "Ma rabtaa udgoon ku siiya kalsooni iyo haybad?",
   "s": 0.3,
   "e": 2.892
  },
  {
   "id": "l2",
   "text": "Kani waa Spicy Oud, Proud Dose, oo ka socda Ibraq.",
   "s": 3.532,
   "e": 6.858
  },
  {
   "id": "l3",
   "text": "Waa cadar tayo sare leh, toddobaatan iyo shan mililitir, ragga iyo dumarkaba.",
   "s": 7.498,
   "e": 12.353
  },
  {
   "id": "l4",
   "text": "Wuxuu ku bilaabmaa cuud iyo ubax cad.",
   "s": 12.993,
   "e": 15.023
  },
  {
   "id": "l5",
   "text": "Wadnihiisu waa karamel, cambar iyo xawaash.",
   "s": 15.663,
   "e": 18.368
  },
  {
   "id": "l6",
   "text": "Salkiisuna waa jasmine, vetiver, misk iyo cuud.",
   "s": 19.008,
   "e": 22.292
  },
  {
   "id": "l7",
   "text": "Waa udgoon diirran oo xoog leh, oo maalinta oo dhan kula socda.",
   "s": 22.932,
   "e": 26.808
  },
  {
   "id": "l8",
   "text": "Waxaad ka heli kartaa Falarosa Luxury, Surrey, BC, Kanada.",
   "s": 27.448,
   "e": 31.573
  },
  {
   "id": "l9",
   "text": "Nagala soo xiriir lambarka ku qoran bogga.",
   "s": 32.213,
   "e": 34.403
  },
  {
   "id": "l10",
   "text": "Spicy Oud, Ibraq. Hadda dalbo!",
   "s": 35.043,
   "e": 37.792
  }
 ],
