{
 "scenes": [
  {
   "id": "hook",
   "text": "Qorraxdu waxay dhaawacdaa maqaarkaaga, xitaa maalmaha daruurta leh!",
   "s": 0.3,
   "e": 3.706
  },
  {
   "id": "uv",
   "text": "Shucaaca UV-ga wuxuu keenaa gubasho, gabow hore, iyo kansarka maqaarka.",
   "s": 4.696,
   "e": 8.939
  },
  {
   "id": "spf",
   "text": "Tallaabada koowaad: dooro kareemka qorraxda oo SPF soddon ama ka badan ah.",
   "s": 9.929,
   "e": 13.928
  },
  {
   "id": "amount",
   "text": "Tallaabada labaad: mari qadar ku filan, qiyaastii laba farood wejiga iyo qoorta.",
   "s": 14.918,
   "e": 19.219
  },
  {
   "id": "time",
   "text": "Tallaabada saddexaad: mari shan iyo toban daqiiqo ka hor intaadan bannaanka u bixin.",
   "s": 20.209,
   "e": 24.538
  },
  {
   "id": "spots",
   "text": "Ha illoobin dhegaha, qoorta, gacmaha dushooda, iyo cagaha.",
   "s": 25.528,
   "e": 28.61
  },
  {
   "id": "reapply",
   "text": "Dib u mari labadii saacadoodba mar, iyo mar kasta oo aad dabaalato ama dhididdo.",
   "s": 29.6,
   "e": 33.834
  },
  {
   "id": "myth",
   "text": "Maqaarka madow sidoo kale wuu gubtaa. Qof kasta wuxuu u baahan yahay ilaalin.",
   "s": 34.824,
   "e": 39.263
  },
  {
   "id": "cta",
   "text": "Maanta bilow, maqaarkaaga ilaali! U dir qof aad jeceshahay.",
   "s": 40.253,
   "e": 43.96
  }
 ],
