            <div class="spot-list">
              <div class="spot" id="sp-ears"><span class="num">1</span>Dhegaha</div>
              <div class="spot" id="sp-neck"><span class="num">2</span>Qoorta</div>
              <div class="spot" id="sp-hands"><span class="num">3</span><span class="t2">Gacmaha dushooda</span></div>
