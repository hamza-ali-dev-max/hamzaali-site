      <!-- 7. REAPPLY -->
      <section id="s-reapply" class="clip" data-start="%reapply.start%" data-duration="%reapply.dur%" data-track-index="1">
        <div class="stage">
          <div class="chip"><i></i>TALLAABO 5<i></i></div>
          <div class="headline"><span class="hl"><span class="hw">Dib</span> <span class="hw">u</span> <span class="hw y">mari</span></span></div>
          <div class="visual">
            <div id="cycle">
              <svg id="cycle-arrows" viewBox="0 0 420 420" fill="none" stroke="#2f6fd0" stroke-width="22" stroke-linecap="round">
                <path d="M60 210 A150 150 0 0 1 300 90" /><path d="M285 55 L318 98 L266 112" stroke-linejoin="round" />
                <path d="M360 210 A150 150 0 0 1 120 330" stroke="#c9a24b" /><path d="M135 365 L102 322 L154 308" stroke="#c9a24b" stroke-linejoin="round" />
