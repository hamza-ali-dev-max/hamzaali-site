      <!-- 8. MYTH -->
      <section id="s-myth" class="clip" data-start="%myth.start%" data-duration="%myth.dur%" data-track-index="1">
        <div class="stage">
          <div class="chip alt"><i></i>XAQIIQ<i></i></div>
          <div class="headline"><span class="hl"><span class="hw y">Maqaarka</span> <span class="hw y">madow</span></span><span class="hl sm"><span class="hw">sidoo</span> <span class="hw">kale</span> <span class="hw">wuu</span> <span class="hw">gubtaa</span></span></div>
          <div class="visual">
            <div class="tones">
              <div class="tone" style="background: #f3d2b3"><div class="ok"><svg width="36" height="28" viewBox="0 0 38 30"><path d="M4 16 L14 26 L34 4" fill="none" stroke="#ffffff" stroke-width="7" stroke-linecap="round" stroke-linejoin="round" /></svg></div></div>
              <div class="tone" style="background: #d9a47c"><div class="ok"><svg width="36" height="28" viewBox="0 0 38 30"><path d="M4 16 L14 26 L34 4" fill="none" stroke="#ffffff" stroke-width="7" stroke-linecap="round" stroke-linejoin="round" /></svg></div></div>
              <div class="tone" style="background: #a86f4a"><div class="ok"><svg width="36" height="28" viewBox="0 0 38 30"><path d="M4 16 L14 26 L34 4" fill="none" stroke="#ffffff" stroke-width="7" stroke-linecap="round" stroke-linejoin="round" /></svg></div></div>
              <div class="tone" style="background: #7a4a2f"><div class="ok"><svg width="36" height="28" viewBox="0 0 38 30"><path d="M4 16 L14 26 L34 4" fill="none" stroke="#ffffff" stroke-width="7" stroke-linecap="round" stroke-linejoin="round" /></svg></div></div>
              <div class="tone" style="background: #4a2a1a"><div class="ok"><svg width="36" height="28" viewBox="0 0 38 30"><path d="M4 16 L14 26 L34 4" fill="none" stroke="#ffffff" stroke-width="7" stroke-linecap="round" stroke-linejoin="round" /></svg></div></div>
            </div>
            <div id="everyone" class="center"><svg width="46" height="42" viewBox="0 0 46 42"><path d="M23 40 C8 28 2 20 2 12 C2 6 7 2 12 2 C17 2 21 5 23 9 C25 5 29 2 34 2 C39 2 44 6 44 12 C44 20 38 28 23 40Z" fill="#b8452f" /></svg><span>Qof kasta</span><svg width="46" height="42" viewBox="0 0 46 42"><path d="M23 40 C8 28 2 20 2 12 C2 6 7 2 12 2 C17 2 21 5 23 9 C25 5 29 2 34 2 C39 2 44 6 44 12 C44 20 38 28 23 40Z" fill="#b8452f" /></svg></div>
          </div>
        </div>
      </section>

      <!-- 9. CTA -->
      <section id="s-cta" class="clip" data-start="%cta.start%" data-duration="%cta.dur%" data-track-index="1">
        <div class="stage">
          <div class="chip"><i></i>MAANTA<i></i></div>
          <div class="headline"><span class="hl"><span class="hw">Maanta</span> <span class="hw y">bilow!</span></span><span class="hl sm" id="cta-sub"><span class="hw">maqaarkaaga</span> <span class="hw y">ilaali</span></span></div>
          <div class="visual">
            <svg id="cta-sun" class="stk" viewBox="0 0 500 500"><g id="cta-rays" fill="#c9a24b"><rect x="238" y="0" width="24" height="80" rx="12" /><rect x="238" y="420" width="24" height="80" rx="12" /><rect x="0" y="238" width="80" height="24" rx="12" /><rect x="420" y="238" width="80" height="24" rx="12" /><rect x="238" y="0" width="24" height="80" rx="12" transform="rotate(45 250 250)" /><rect x="238" y="420" width="24" height="80" rx="12" transform="rotate(45 250 250)" /><rect x="0" y="238" width="80" height="24" rx="12" transform="rotate(45 250 250)" /><rect x="420" y="238" width="80" height="24" rx="12" transform="rotate(45 250 250)" /></g><circle cx="250" cy="250" r="140" fill="url(#sg)" /></svg>
            <svg id="cta-shield" class="stk" viewBox="0 0 210 250"><path d="M105 6 L200 40 V120 C200 185 160 225 105 244 C50 225 10 185 10 120 V40 Z" fill="#2f6fd0" stroke="#c9a24b" stroke-width="10" stroke-linejoin="round" /><path d="M105 72 l14 42 h44 l-36 26 14 42 -36 -26 -36 26 14 -42 -36 -26 h44 z" fill="#ffffff" /></svg>
            <div id="share" class="center stk"><svg id="tiktok" viewBox="0 0 48 48"><rect width="48" height="48" rx="11" fill="#000000" /><g transform="translate(7.8 7.8) scale(1.35)"><path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.650-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z" fill="#25f4ee" transform="translate(-0.9 -0.9)" /><path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.650-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z" fill="#fe2c55" transform="translate(0.9 0.9)" /><path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.650-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z" fill="#ffffff" /></g></svg><span>U dir qof aad jeceshahay</span><svg id="share-arrow" viewBox="0 0 64 64"><path d="M36 10 L58 30 L36 50 V38 C22 38 12 42 6 54 C8 34 18 24 36 22 Z" fill="#ffffff" /></svg></div>
          </div>
        </div>
      </section>

      <!-- persistent chrome above scenes -->
      <div id="brand"><svg width="30" height="28" viewBox="0 0 46 42"><path d="M23 40 C8 28 2 20 2 12 C2 6 7 2 12 2 C17 2 21 5 23 9 C25 5 29 2 34 2 C39 2 44 6 44 12 C44 20 38 28 23 40Z" fill="#2f6fd0" /></svg>QORRAXDA &amp; MAQAARKA</div>
      <div id="prog"><span id="prog-fill"></span></div>
      <div id="caps">
        %CAPTIONS%
      </div>
      <div id="flash"></div>

    %AUDIO%
    </div>
    <script>
      const D = %DATA%;
      const tl = gsap.timeline({ paused: true });
      const S = {};
      D.scenes.forEach((s) => (S[s.id] = s));
      const B = D.beats;
      const q = (sel) => document.querySelector(sel);

      // persistent theme motion: the woven lattice and patterned band drift slowly, progress fills
      tl.fromTo("#weave", { backgroundPosition: "0px 0px" }, { backgroundPosition: "0px 240px", duration: 45, ease: "none" }, 0);
      tl.fromTo("#band", { backgroundPosition: "0px 0px" }, { backgroundPosition: "240px 0px", duration: 45, ease: "none" }, 0);
      tl.fromTo("#prog-fill", { scaleX: 0 }, { scaleX: 1, duration: 45, ease: "none" }, 0);

      // every scene: hard cut + gold flash, punch-in landing, a mid-scene jump-cut zoom
      D.scenes.forEach((s, i) => {
        const el = q("#s-" + s.id);
        const stage = el.querySelector(".stage");
        const dir = i % 2 ? -1 : 1;
        tl.fromTo(stage, { scale: 1.16, x: 90 * dir }, { scale: 1, x: 0, duration: 0.38, ease: "power3.out" }, s.start);
        const jump = s.start + s.dur * 0.56;
        tl.set(stage, { scale: 1.07 }, jump);
        tl.to(stage, { scale: 1.1, duration: s.dur * 0.44 - 0.02, ease: "none" }, jump + 0.01);
        if (i > 0) {
          tl.set("#flash", { opacity: 0.55 }, s.start);
          tl.to("#flash", { opacity: 0, duration: 0.16, ease: "power2.out" }, s.start + 0.001);
        }
        tl.fromTo(el.querySelector(".chip"), { scale: 0.4, opacity: 0 }, { scale: 1, opacity: 1, duration: 0.3, ease: "back.out(3)" }, s.start + 0.05);
        tl.fromTo(el.querySelectorAll(".hw"), { yPercent: 105 }, { yPercent: 0, duration: 0.42, stagger: 0.06, ease: "power4.out" }, s.start + 0.08);
      });

      // 1 hook
      tl.fromTo("#sun", { scale: 0.3, opacity: 0 }, { scale: 1, opacity: 1, duration: 0.6, ease: "back.out(1.8)" }, S.hook.start + 0.1);
      tl.fromTo("#sun-rays", { rotation: 0, svgOrigin: "250 250" }, { rotation: 90, svgOrigin: "250 250", duration: S.hook.dur, ease: "none" }, S.hook.start);
      tl.fromTo("#skin-bar", { scaleX: 0 }, { scaleX: 1, duration: 0.5, ease: "power3.out" }, S.hook.start + 0.4);
      tl.fromTo("#cloud", { x: -760 }, { x: 0, duration: 0.5, ease: "power3.out" }, B.cloud - 0.15);
      tl.fromTo(".uv", { strokeDasharray: 400, strokeDashoffset: 400 }, { strokeDashoffset: 0, duration: 0.5, stagger: 0.08, ease: "power2.in" }, B.cloud + 0.25);
      tl.to("#skin-bar", { background: "linear-gradient(90deg,#8e2f1e,#b8452f,#d9745a)", duration: 0.3 }, B.cloud + 0.7);
      tl.fromTo("#hook-sticker", { scale: 0, rotation: -20 }, { scale: 1, rotation: -6, duration: 0.35, ease: "back.out(2.5)" }, B.cloud + 0.3);

      // 2 uv
      [["#c-burn", B.burn], ["#c-age", B.age], ["#c-cancer", B.cancer]].forEach(([sel, t], i) => {
        tl.fromTo(sel, { x: i % 2 ? -900 : 900, opacity: 0 }, { x: 0, opacity: 1, duration: 0.32, ease: "power4.out" }, t - 0.08);
        tl.fromTo(sel + " .ic", { scale: 0.3 }, { scale: 1, duration: 0.4, ease: "back.out(3)" }, t + 0.05);
      });

      // 3 spf
      tl.fromTo("#tube", { y: 700, rotation: 25 }, { y: 0, rotation: -10, duration: 0.55, ease: "back.out(1.4)" }, S.spf.start + 0.25);
      tl.fromTo("#stamp", { scale: 3, opacity: 0, rotation: 12 }, { scale: 1, opacity: 1, rotation: -4, duration: 0.25, ease: "power4.in" }, B.spf - 0.2);
      tl.fromTo("#s-spf .visual", { y: 0 }, { y: 14, duration: 0.05, yoyo: true, repeat: 3, ease: "none" }, B.spf + 0.05);
      tl.fromTo("#spf-more", { scale: 0, opacity: 0 }, { scale: 1, opacity: 1, duration: 0.3, ease: "back.out(2.5)" }, B.more);

      // 4 amount
      tl.fromTo("#f1", { y: 700 }, { y: 0, duration: 0.45, ease: "power3.out" }, S.amount.start + 0.25);
      tl.fromTo("#f2", { y: 700 }, { y: 0, duration: 0.45, ease: "power3.out" }, S.amount.start + 0.35);
      tl.fromTo(".finger .cream", { scaleY: 0 }, { scaleY: 1, duration: 0.55, stagger: 0.18, ease: "power2.out" }, B.fingers - 0.3);
      tl.fromTo("#two-f", { scale: 0.3, opacity: 0 }, { scale: 1, opacity: 1, duration: 0.35, ease: "back.out(2.2)" }, B.fingers);
      tl.fromTo("#face-eq", { x: 300, opacity: 0 }, { x: 0, opacity: 1, duration: 0.35, ease: "power3.out" }, B.face);

      // 5 time
      tl.fromTo("#timer", { scale: 0.5, opacity: 0 }, { scale: 1, opacity: 1, duration: 0.45, ease: "back.out(1.8)" }, S.time.start + 0.2);
      const cd = { v: 15 };
      tl.fromTo(cd, { v: 15 }, { v: 0, duration: B.outside - B.fifteen, ease: "none", onUpdate: () => (q("#tn").textContent = String(Math.ceil(cd.v))) }, B.fifteen);
      tl.fromTo("#ring", { strokeDashoffset: 0 }, { strokeDashoffset: 1382.3, duration: B.outside - B.fifteen, ease: "none" }, B.fifteen);
      tl.fromTo("#go-out", { y: 200, opacity: 0 }, { y: 0, opacity: 1, duration: 0.35, ease: "back.out(2)" }, B.outside - 0.1);

      // 6 spots
      tl.fromTo("#body", { y: 80, opacity: 0 }, { y: 0, opacity: 1, duration: 0.4, ease: "power3.out" }, S.spots.start + 0.2);
      tl.set(".dot", { opacity: 0 }, S.spots.start);
      ["ears", "neck", "hands", "feet"].forEach((k) => {
        tl.fromTo("#sp-" + k, { x: 520, opacity: 0 }, { x: 0, opacity: 1, duration: 0.28, ease: "power4.out" }, B[k] - 0.05);
        tl.fromTo("#d-" + k, { scale: 0, opacity: 0, transformOrigin: "50% 50%" }, { scale: 1.5, opacity: 1, duration: 0.3, ease: "back.out(4)" }, B[k]);
      });

      // 7 reapply
      tl.fromTo("#cycle", { scale: 0.4, opacity: 0 }, { scale: 1, opacity: 1, duration: 0.45, ease: "back.out(1.8)" }, S.reapply.start + 0.2);
      tl.fromTo("#cycle-arrows", { rotation: 0 }, { rotation: 360, duration: S.reapply.dur, ease: "none" }, S.reapply.start);
      tl.fromTo("#cycle-num .n", { scale: 1 }, { scale: 1.25, duration: 0.18, yoyo: true, repeat: 1, ease: "power2.out" }, B.two);
      tl.fromTo("#p-swim", { y: 260, opacity: 0 }, { y: 0, opacity: 1, duration: 0.32, ease: "back.out(2)" }, B.swim - 0.05);
      tl.fromTo("#p-sweat", { y: 260, opacity: 0 }, { y: 0, opacity: 1, duration: 0.32, ease: "back.out(2)" }, B.sweat - 0.05);

      // 8 myth
      tl.fromTo(".tone", { scale: 0, opacity: 0 }, { scale: 1, opacity: 1, duration: 0.35, stagger: 0.08, ease: "back.out(2.2)" }, S.myth.start + 0.3);
      tl.fromTo(".tone .ok", { scale: 0 }, { scale: 1, duration: 0.3, stagger: 0.07, ease: "back.out(3)" }, B.everyone);
      tl.fromTo("#everyone", { scaleX: 0, opacity: 0 }, { scaleX: 1, opacity: 1, duration: 0.3, ease: "power4.out" }, B.everyone - 0.05);

      // 9 cta
      tl.fromTo("#cta-sun", { scale: 0.3, opacity: 0 }, { scale: 1, opacity: 1, duration: 0.5, ease: "back.out(1.6)" }, S.cta.start + 0.15);
      tl.fromTo("#cta-rays", { rotation: 0, svgOrigin: "250 250" }, { rotation: 60, svgOrigin: "250 250", duration: S.cta.dur, ease: "none" }, S.cta.start);
      tl.fromTo("#cta-shield", { y: 400, opacity: 0 }, { y: 0, opacity: 1, duration: 0.45, ease: "back.out(1.6)" }, B.protect - 0.15);
      tl.fromTo("#share", { y: 240, opacity: 0 }, { y: 0, opacity: 1, duration: 0.35, ease: "back.out(2)" }, B.share - 0.1);
      tl.fromTo("#tiktok", { scale: 0, rotation: -30 }, { scale: 1, rotation: 0, duration: 0.4, ease: "back.out(3)" }, B.share + 0.05);
      tl.fromTo("#share-arrow", { x: 0 }, { x: 14, duration: 0.25, yoyo: true, repeat: 5, ease: "sine.inOut" }, B.share + 0.3);

      // captions: word-by-word karaoke in Somali (active word in Somali blue)
      D.caps.forEach((g, gi) => {
        const line = "#cap-" + gi;
        tl.set(line, { opacity: 1 }, g.s);
        tl.fromTo(line, { scale: 0.86 }, { scale: 1, duration: 0.12, ease: "back.out(3)", immediateRender: false }, g.s);
        tl.set(line, { opacity: 0 }, g.e);
        g.w.forEach((w, wi) => {
          const id = "#cw-" + gi + "-" + wi;
          tl.set(id, { color: "#2f6fd0" }, w.s);
          if (wi + 1 < g.w.length) tl.set(id, { color: "#4a2e1a" }, g.w[wi + 1].s);
        });
      });

      window.__timelines["main"] = tl;
    </script>
  </body>
</html>
