{
 "scenes": [
  {
   "id": "q",
   "text": "Maxaa tretinoin looga hadal hayaa daryeelka maqaarka?",
   "s": 0.3,
   "e": 3.142
  },
  {
   "id": "what",
   "text": "Waa daawo maqaarka la mariyo oo ka tirsan qoyska fitamiin A.",
   "s": 3.782,
   "e": 7.021
  },
  {
   "id": "acne",
   "text": "Waxay caawisaa daaweynta finanka iyo furista daloollada maqaarka ee xirmay.",
   "s": 7.661,
   "e": 11.525
  },
  {
   "id": "cells",
   "text": "Waxay kordhisaa samaysanka unugyo cusub oo maqaarka ah.",
   "s": 12.165,
   "e": 15.158
  },
  {
   "id": "lines",
   "text": "Waxay sidoo kale yarayn kartaa muuqaalka laalaabka yaryar ee wejiga.",
   "s": 15.798,
   "e": 19.332
  },
  {
   "id": "patience",
   "text": "Laakiin natiijadu hal habeen kuma timaaddo, waxay u baahan tahay toddobaadyo ama bilo.",
   "s": 19.972,
   "e": 24.592
  },
  {
   "id": "steady",
   "text": "Isticmaal joogto ah oo waafaqsan talada dhakhtarka ayaa muhiim ah.",
   "s": 25.232,
   "e": 28.638
  },
  {
   "id": "toomuch",
   "text": "Wax badan oo la mariyo natiijada ma dedejiso, waxayna keeni kartaa qallayl iyo cuncun.",
   "s": 29.278,
   "e": 33.857
  },
  {
   "id": "sun",
   "text": "Isticmaal kareemka qorraxda kaa difaaca, raacna tilmaamaha dhakhtarka.",
   "s": 34.497,
   "e": 38.279
  },
  {
   "id": "preg",
   "text": "Haddii aad uur leedahay ama qorshaynayso, kala tasho dhakhtar ka hor isticmaalka.",
   "s": 38.919,
   "e": 43.014
  },
  {
   "id": "cta",
   "text": "La soco Skincare by Ubah, si aad maqaarkaaga si fiican ugu daryeesho!",
   "s": 43.654,
   "e": 47.552
  }
 ],
