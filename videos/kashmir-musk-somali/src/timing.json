{
 "scenes": [
  {
   "id": "l1",
   "text": "Waxaan idin tusayaa Kashmir Musk, oo ka socda Arabian Oud!",
   "s": 0.3,
   "e": 3.452
  },
  {
   "id": "l2",
   "text": "Waa udgoon misk ah oo jilicsan sida dhar kashmir ah, ragga iyo dumarkaba ku habboon.",
   "s": 4.092,
   "e": 8.641
  },
  {
   "id": "l3",
   "text": "Wuxuu ku bilaabmaa ubaxa pear, filfil casaan iyo bergamot.",
   "s": 9.281,
   "e": 12.561
  },
  {
   "id": "l4",
   "text": "Wadnihiisa waxaa ku jira jasmine iyo tuberose.",
   "s": 13.201,
   "e": 15.788
  },
  {
   "id": "l5",
   "text": "Salkiisa hoose waa misk iyo patchouli.",
   "s": 16.428,
   "e": 18.515
  },
  {
   "id": "l6",
   "text": "Arabian Oud waxay ka bilaabatay Riyaad sannadkii kun sagaal boqol siddeetan iyo labo.",
   "s": 19.155,
   "e": 23.738
  },
  {
   "id": "l7",
   "text": "Maanta waxay leedahay in ka badan kun iyo laba boqol oo dukaan, soddon iyo toddoba waddan.",
   "s": 24.378,
   "e": 29.096
  },
  {
   "id": "l8",
   "text": "Waxaad ka heli kartaa Falarosa Luxury, Surrey, BC, Kanada.",
   "s": 29.736,
   "e": 33.059
  },
  {
   "id": "l9",
   "text": "Nagala soo xiriir lambarka ku qoran bogga.",
   "s": 33.699,
   "e": 35.849
  },
  {
   "id": "l10",
   "text": "Kashmir Musk, Arabian Oud. Hadda dalbo!",
   "s": 36.489,
   "e": 39.16
  }
 ],
