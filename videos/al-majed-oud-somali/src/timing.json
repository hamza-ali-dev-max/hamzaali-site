{
 "scenes": [
  {
   "id": "hook",
   "text": "Udgoon Carabeed oo dhab ah, gurigaaga u keen!",
   "s": 0.3,
   "e": 2.775
  },
  {
   "id": "what",
   "text": "Kani waa Al Majed Oud, jajab qori cuud ah oo lagu qooyay saliid udgoon.",
   "s": 3.415,
   "e": 7.353
  },
  {
   "id": "made",
   "text": "Waxaa lagu sameeyay Riyaad, Sacuudiga, waxaana ku jira quraarad qurxoon oo dabool alwaax iyo dahab leh.",
   "s": 7.993,
   "e": 13.582
  },
  {
   "id": "how",
   "text": "Gabal yar dul dhig dhuxul kulul ama dabqaad koronto.",
   "s": 14.222,
   "e": 16.985
  },
  {
   "id": "when",
   "text": "Ku shid ka hor inta martidu imaan, maalinta Jimcaha, ciidaha iyo aroosyada.",
   "s": 17.625,
   "e": 21.653
  },
  {
   "id": "air",
   "text": "Qolka hawo sii, wax yarna waa ku filan, udgoonku wuu sii jiraa.",
   "s": 22.293,
   "e": 25.909
  },
  {
   "id": "safe",
   "text": "Dharka meel fog ka udgoomi, indhaha iyo carruurtana ka fogee.",
   "s": 26.549,
   "e": 29.711
  },
  {
   "id": "cta",
   "text": "Al Majed Oud, udgoonka gurigaaga. Hadda raadso!",
   "s": 30.351,
   "e": 33.427
  }
 ],
