{
 "scenes": [
  {
   "id": "q",
   "text": "Ma wejigaaga si xoog leh ayaad u xoqdaa markaad dhaqayso?",
   "s": 0.3,
   "e": 2.827
  },
  {
   "id": "stop",
   "text": "Jooji, xoqid badan waxay keeni kartaa cuncun iyo maqaarka oo xanaaqa.",
   "s": 3.517,
   "e": 6.676
  },
  {
   "id": "gentle",
   "text": "Nadiifintu xoog uma baahna, waxay u baahan tahay daryeel tartiib ah.",
   "s": 7.366,
   "e": 10.461
  },
  {
   "id": "products",
   "text": "Isticmaal biyo diirran iyo nadiifiye jilicsan oo wejiga loogu talagalay.",
   "s": 11.151,
   "e": 14.387
  },
  {
   "id": "fingers",
   "text": "Farahaaga si tartiib ah ugu mari, hana isticmaalin isbuunyo adag.",
   "s": 15.077,
   "e": 17.871
  },
  {
   "id": "rinse",
   "text": "Si fiican u raaci, dabadeed tuwaal jilicsan si tartiib ah ugu qalaji.",
   "s": 18.561,
   "e": 21.812
  },
  {
   "id": "moist",
   "text": "Haddii maqaarku qalalan yahay, mari kareem qoyaan siiya.",
   "s": 22.502,
   "e": 24.891
  },
  {
   "id": "when",
   "text": "Wejiga dhaq subaxdii, habeenkii, iyo markaad aad u dhididdo.",
   "s": 25.581,
   "e": 28.205
  },
  {
   "id": "nocure",
   "text": "Dhaqid badan maalintii oo dhan ma aha xal finanka lagu tirtiro.",
   "s": 28.895,
   "e": 31.503
  },
  {
   "id": "kind",
   "text": "Maqaarkaaga u naxariiso, quruxdu waxay ka bilaabataa daryeel wanaagsan.",
   "s": 32.193,
   "e": 35.327
  },
  {
   "id": "cta",
   "text": "La wadaag qof u baahan taladan, lana soco Skincare by Ubah.",
   "s": 36.017,
   "e": 39.45
  }
 ],
