{
 "scenes": [
  {
   "id": "q",
   "text": "Ma daawada cadayga ayaad finanka marisaa?",
   "s": 0.3,
   "e": 2.475
  },
  {
   "id": "wait",
   "text": "Sug, taladaas waxay dhaawici kartaa maqaarkaaga!",
   "s": 3.115,
   "e": 5.633
  },
  {
   "id": "teeth",
   "text": "Daawada cadayga waxaa loogu talagalay ilkaha, mana aha daawo finan.",
   "s": 6.273,
   "e": 9.83
  },
  {
   "id": "harm",
   "text": "Waxay keeni kartaa qallayl, cuncun iyo maqaarka oo xanaaqa.",
   "s": 10.47,
   "e": 13.639
  },
  {
   "id": "dry",
   "text": "Finku inuu qalalo macnaheedu ma aha inuu si fiican u bogsanayo.",
   "s": 14.279,
   "e": 17.768
  },
  {
   "id": "wash",
   "text": "Taa beddelkeed, wejiga si tartiib ah ugu dhaq nadiifiye jilicsan.",
   "s": 18.408,
   "e": 22.066
  },
  {
   "id": "treat",
   "text": "Isticmaal daawo finanka loogu talagalay, raacna tilmaamaha ku qoran.",
   "s": 22.706,
   "e": 26.382
  },
  {
   "id": "hacks",
   "text": "Ha tuujin finanka, hana isku dayin wax kasta oo baraha bulshada lagu sheego.",
   "s": 27.022,
   "e": 30.84
  },
  {
   "id": "doctor",
   "text": "Haddii finanku xanuun badan yihiin ama aysan kaa tegin, la tasho dhakhtarka maqaarka.",
   "s": 31.48,
   "e": 35.868
  },
  {
   "id": "remind",
   "text": "Ilkahaaga caday, maqaarkaagana u naxariiso!",
   "s": 36.508,
   "e": 38.925
  },
  {
   "id": "cta",
   "text": "La wadaag qof u baahan taladan, lana soco Skincare by Ubah.",
   "s": 39.565,
   "e": 42.865
  }
 ],
