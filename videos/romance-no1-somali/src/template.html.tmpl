            <div class="lab tag" id="l8-t0" style="left:630px;top:360px;font-size:34px"><i style="background:#b8452f"></i>Surrey, BC</div>
            <div class="disc2" id="l8-leaf" style="left:470px;top:490px;width:130px;height:130px"><svg width="120" height="120" viewBox="0 0 120 120"><path d="M60 8 L68 30 L82 22 L78 48 L100 38 L94 54 L112 60 L84 76 L90 88 L64 82 L64 112 L56 112 L56 82 L30 88 L36 76 L8 60 L26 54 L20 38 L42 48 L38 22 L52 30Z" fill="#d52b1e" /></svg></div>
            <div class="lab tag" id="l8-t1" style="left:620px;top:520px;font-size:34px"><i style="background:#d52b1e"></i>Kanada</div>
          </div>
        </div>
      </section>
      <section id="s-l9" class="clip" data-start="%l9.start%" data-duration="%l9.dur%" data-track-index="1">
        <div class="stage">
          <div class="chip"><i></i>LA XIRIIR<i></i></div>
          <div class="headline"><span class="hl"><span class="hw y">Nala</span> <span class="hw y">soo</span> <span class="hw y">xiriir</span></span><span class="hl sm"><span class="hw">lambarka</span> <span class="hw">bogga</span></span></div>
          <div class="visual">
            <div class="disc2" id="l9-phone" style="left:40px;top:20px;width:300px;height:300px"><svg width="150" height="150" viewBox="0 0 150 150"><rect x="44" y="14" width="62" height="122" rx="12" fill="#1c3f86" /><rect x="50" y="28" width="50" height="86" rx="4" fill="#cfe3fb" /><circle cx="75" cy="124" r="5" fill="#fff" /><g id="rings" fill="none" stroke="#c9a24b" stroke-width="6" stroke-linecap="round"><path d="M116 50 q12 25 0 50" /><path d="M128 38 q20 37 0 74" /><path d="M34 50 q-12 25 0 50" /><path d="M22 38 q-20 37 0 74" /></g></svg></div>
            <div class="lab tag" id="l9-t0" style="left:390px;top:60px"><i style="background:#2f6fd0"></i>Nala soo xiriir</div>
            <div class="lab tag" id="l9-t1" style="left:390px;top:180px"><i style="background:#c9a24b"></i>Lambarka bogga</div>
            <svg id="arrowdn" viewBox="0 0 90 120" style="position:absolute;left:180px;top:380px;width:90px;height:120px"><path d="M45 8 V96 M14 66 L45 100 L76 66" fill="none" stroke="#2f6fd0" stroke-width="14" stroke-linecap="round" stroke-linejoin="round" /></svg>
            <div class="cut" id="l9-p" style="left:650px;top:290px;width:230px;height:330px"><img src="assets/photos/bottle-cut.png" alt="" /></div>
          </div>
        </div>
      </section>
      <section id="s-l10" class="clip" data-start="%l10.start%" data-duration="%l10.dur%" data-track-index="1">
        <div class="stage">
          <div class="chip"><i></i>HADDA<i></i></div>
          <div class="headline"><span class="hl"><span class="hw y">Hadda</span> <span class="hw y">dalbo</span></span><span class="hl sm"><span class="hw">Falarosa</span> <span class="hw">Luxury</span></span></div>
          <div class="visual">
            <div class="cut" id="l10-p" style="left:40px;top:0px;width:400px;height:575px"><img src="assets/photos/bottle-cut.png" alt="" /></div>
            <div id="g-name">Romance<br />N°1</div>
            <div id="g-ar">طيف الإمارات</div><div id="g-en">TAIF AL EMARAT</div>
            <div id="g-buy" class="center stk">HADDA DALBO</div>
          </div>
        </div>
      </section>

      <!-- persistent chrome above scenes -->
      <div id="brand"><svg width="30" height="28" viewBox="0 0 46 42"><path d="M23 40 C8 28 2 20 2 12 C2 6 7 2 12 2 C17 2 21 5 23 9 C25 5 29 2 34 2 C39 2 44 6 44 12 C44 20 38 28 23 40Z" fill="#c9a24b" /></svg>TAIF AL EMARAT · ROMANCE N°1</div>
      <div id="prog"><span id="prog-fill"></span></div>
      <div id="caps">
        %CAPTIONS%
      </div>
      <div id="flash"></div>

    %AUDIO%
    </div>
    <script>
      const D = %DATA%;
      const tl = gsap.timeline({ paused: true });
      const S = {};
      D.scenes.forEach((s) => (S[s.id] = s));
      const B = D.beats;
      const q = (sel) => document.querySelector(sel);
      const pop = (sel, t, from = 0.3) => tl.fromTo(sel, { scale: from, opacity: 0 }, { scale: 1, opacity: 1, duration: 0.35, ease: "back.out(2.4)" }, t);
      const drift = (sel, t, dur) => tl.fromTo(sel, { y: 30, opacity: 0 }, { y: -40, opacity: 1, duration: dur, ease: "sine.out" }, t);

      // persistent theme motion
      tl.fromTo("#weave", { backgroundPosition: "0px 0px" }, { backgroundPosition: "0px 180px", duration: D.total, ease: "none" }, 0);
      tl.fromTo("#band", { backgroundPosition: "0px 0px" }, { backgroundPosition: "180px 0px", duration: D.total, ease: "none" }, 0);
      tl.fromTo("#prog-fill", { scaleX: 0 }, { scaleX: 1, duration: D.total, ease: "none" }, 0);

      // every scene: hard cut + gold flash, punch-in landing, a mid-scene jump-cut zoom
      D.scenes.forEach((s, i) => {
        const el = q("#s-" + s.id);
        const stage = el.querySelector(".stage");
        const dir = i % 2 ? -1 : 1;
        tl.fromTo(stage, { scale: 1.16, x: 90 * dir }, { scale: 1, x: 0, duration: 0.38, ease: "power3.out" }, s.start);
        const jump = s.start + s.dur * 0.56;
        tl.set(stage, { scale: 1.07 }, jump);
        tl.to(stage, { scale: 1.1, duration: s.dur * 0.44 - 0.02, ease: "none" }, jump + 0.01);
        if (i > 0) {
          tl.set("#flash", { opacity: 0.55 }, s.start);
          tl.to("#flash", { opacity: 0, duration: 0.16, ease: "power2.out" }, s.start + 0.001);
        }
        tl.fromTo(el.querySelector(".chip"), { scale: 0.4, opacity: 0 }, { scale: 1, opacity: 1, duration: 0.3, ease: "back.out(3)" }, s.start + 0.05);
        tl.fromTo(el.querySelectorAll(".hw"), { yPercent: 105 }, { yPercent: 0, duration: 0.42, stagger: 0.06, ease: "power4.out" }, s.start + 0.08);
        // slow Ken Burns on every real photo in the scene
        el.querySelectorAll(".photo img, .cut img").forEach((img) => tl.fromTo(img, { scale: 1.02 }, { scale: 1.14, duration: s.dur, ease: "none" }, s.start));
      });

      // product scenes (generated by adgen.py)
      tl.fromTo("#l1-b2", { y: 500, opacity: 0 }, { y: 0, opacity: 1, duration: 0.55, ease: "back.out(1.4)" }, S.l1.start+0.1);
      tl.fromTo("#l1-b3", { y: 500, opacity: 0 }, { y: 0, opacity: 1, duration: 0.55, ease: "back.out(1.4)" }, S.l1.start+0.25);
      tl.fromTo("#l1-b1", { y: 500, opacity: 0 }, { y: 0, opacity: 1, duration: 0.55, ease: "back.out(1.4)" }, B.brand-0.3);
      tl.fromTo(".hs", { scale: 0, opacity: 0, transformOrigin: "50% 50%" }, { scale: 1, opacity: 1, duration: 0.3, stagger: 0.12, ease: "back.out(3)" }, B.brand+0.2);
      pop("#l2-p", S.l2.start+0.1);
      pop("#l2-t0", B.l2t0);
      pop("#l2-t1", B.l2t1);
      pop("#l2-x", B.l2x);
      pop("#l3-p", S.l3.start+0.1);
      pop("#l3-n0", B.l3n0-0.1);
      tl.fromTo("#l3-l0", { x: 120, opacity: 0 }, { x: 0, opacity: 1, duration: 0.4, ease: "power3.out" }, B.l3n0);
      pop("#l3-n1", B.l3n1-0.1);
      tl.fromTo("#l3-l1", { x: 120, opacity: 0 }, { x: 0, opacity: 1, duration: 0.4, ease: "power3.out" }, B.l3n1);
      pop("#l3-n2", B.l3n2-0.1);
      tl.fromTo("#l3-l2", { x: 120, opacity: 0 }, { x: 0, opacity: 1, duration: 0.4, ease: "power3.out" }, B.l3n2);
      pop("#l4-p", S.l4.start+0.1);
      pop("#l4-n0", B.l4n0-0.1);
      tl.fromTo("#l4-l0", { x: 120, opacity: 0 }, { x: 0, opacity: 1, duration: 0.4, ease: "power3.out" }, B.l4n0);
      pop("#l5-card", S.l5.start+0.1);
      pop("#l5-p", S.l5.start+0.35);
      tl.fromTo("#l5-r0 .hi", { opacity: 0 }, { opacity: 1, duration: 0.2 }, B.l5r0); tl.fromTo("#l5-r0 text", { x: -20, opacity: 0 }, { x: 0, opacity: 1, duration: 0.3, ease: "back.out(3)" }, B.l5r0);
      tl.fromTo("#l5-r1 .hi", { opacity: 0 }, { opacity: 1, duration: 0.2 }, B.l5r1); tl.fromTo("#l5-r1 text", { x: -20, opacity: 0 }, { x: 0, opacity: 1, duration: 0.3, ease: "back.out(3)" }, B.l5r1);
      pop("#l6-p", S.l6.start+0.1);
      pop("#l6-d0", B.l6f0-0.15);
      pop("#l6-t0", B.l6f0+0.1);
      pop("#l6-d1", B.l6f1-0.15);
      pop("#l6-t1", B.l6f1+0.1);
      pop("#l7-p", S.l7.start+0.1);
      pop("#l7-t0", B.l7t0);
      pop("#l7-t1", B.l7t1);
      pop("#l8-store", S.l8.start+0.1);
      pop("#l8-name", B.shop, 0.6);
      pop("#l8-pin", B.surrey-0.1);
      pop("#l8-t0", B.surrey+0.05);
      pop("#l8-leaf", B.canada-0.1);
      pop("#l8-t1", B.canada+0.05);
      pop("#l9-phone", S.l9.start+0.1);
      tl.fromTo("#rings", { opacity: 0 }, { opacity: 1, duration: 0.12, yoyo: true, repeat: 7 }, S.l9.start+0.3);
      pop("#l9-t0", B.call);
      pop("#l9-t1", B.num);
      tl.fromTo("#arrowdn", { y: -30, opacity: 0 }, { y: 0, opacity: 1, duration: 0.3, ease: "power2.out" }, B.num+0.1); tl.to("#arrowdn", { y: 22, duration: 0.3, yoyo: true, repeat: 5, ease: "sine.inOut" }, B.num+0.1+0.35);
      pop("#l9-p", S.l9.start+0.4);
      tl.fromTo("#l10-p", { x: -400, opacity: 0 }, { x: 0, opacity: 1, duration: 0.45, ease: "power3.out" }, S.l10.start+0.1);
      pop("#g-name", B.cname, 0.6);
      pop("#g-ar", B.cname+0.4, 0.6);
      pop("#g-en", B.cname+0.6, 0.6);
      tl.fromTo("#g-buy", { y: 240, opacity: 0 }, { y: 0, opacity: 1, duration: 0.35, ease: "back.out(2)" }, B.buy-0.1); tl.fromTo("#g-buy", { scale: 1 }, { scale: 1.06, duration: 0.3, yoyo: true, repeat: 3, ease: "sine.inOut" }, B.buy+0.4);

      // captions: word-by-word karaoke in Somali
      D.caps.forEach((g, gi) => {
        const line = "#cap-" + gi;
        tl.set(line, { opacity: 1 }, g.s);
        tl.fromTo(line, { scale: 0.86 }, { scale: 1, duration: 0.12, ease: "back.out(3)", immediateRender: false }, g.s);
        tl.set(line, { opacity: 0 }, g.e);
        g.w.forEach((w, wi) => {
          const id = "#cw-" + gi + "-" + wi;
          tl.set(id, { color: "#2f6fd0" }, w.s);
          if (wi + 1 < g.w.length) tl.set(id, { color: "#4a2e1a" }, g.w[wi + 1].s);
        });
      });

      window.__timelines["main"] = tl;
    </script>
  </body>
</html>
