{
 "scenes": [
  {
   "id": "l1",
   "text": "Waxaan idin tusayaa cadarrada Taif Al Emarat, ururka Romance!",
   "s": 0.3,
   "e": 3.777
  },
  {
   "id": "l2",
   "text": "Kani waa Romance N°1, udgoon ubax ah oo iftiin leh, oo dumarka loogu talagalay.",
   "s": 4.417,
   "e": 9.307
  },
  {
   "id": "l3",
   "text": "Wuxuu ku bilaabmaa ubaxa liinta iyo jasmine, wadnihiisuna waa tuberose.",
   "s": 9.947,
   "e": 13.984
  },
  {
   "id": "l4",
   "text": "Salkiisa hoose waa amber diiran oo jilicsan.",
   "s": 14.624,
   "e": 17.075
  },
  {
   "id": "l5",
   "text": "Waxaa lagu sameeyay aalkolo dabiici ah oo aan caraf lahayn iyo saliid udgoon dabiici ah.",
   "s": 17.715,
   "e": 22.519
  },
  {
   "id": "l6",
   "text": "Saxanka dahabka ah ee quraaradda waxaa ku qoran magaca Taif, far Carabi ah.",
   "s": 23.159,
   "e": 27.133
  },
  {
   "id": "l7",
   "text": "Haddii aad rabto udgoonka ugu xooggan, eeg Romance N°3.",
   "s": 27.773,
   "e": 31.108
  },
  {
   "id": "l8",
   "text": "Waxaad ka heli kartaa Falarosa Luxury, Surrey, BC, Kanada.",
   "s": 31.748,
   "e": 35.071
  },
  {
   "id": "l9",
   "text": "Nagala soo xiriir lambarka ku qoran bogga.",
   "s": 35.711,
   "e": 37.861
  },
  {
   "id": "l10",
   "text": "Romance N°1, Taif Al Emarat. Hadda dalbo!",
   "s": 38.501,
   "e": 41.586
  }
 ],
