{
 "scenes": [
  {
   "id": "l1",
   "text": "Waxaan idin tusayaa Rose Noir, oo ka socda Ahmed Al Maghribi!",
   "s": 0.3,
   "e": 3.62
  },
  {
   "id": "l2",
   "text": "Waa jel jir oo udgoon, oo si tartiib ah maqaarkaaga ugu dhex milma.",
   "s": 4.26,
   "e": 8.047
  },
  {
   "id": "l3",
   "text": "Wuxuu ku bilaabmaa liin Sicilian ah iyo tufaax cusub.",
   "s": 8.687,
   "e": 11.431
  },
  {
   "id": "l4",
   "text": "Wadnihiisu waa jasmine iyo lily, vanilla iyo udgoon badeed.",
   "s": 12.071,
   "e": 15.405
  },
  {
   "id": "l5",
   "text": "Salkiisuna waa ambroxan, cashmeran iyo qori sandal ah.",
   "s": 16.045,
   "e": 19.122
  },
  {
   "id": "l6",
   "text": "Waa soddon mililitir, ragga iyo dumarkaba wuu ku habboon yahay.",
   "s": 19.762,
   "e": 23.097
  },
  {
   "id": "l7",
   "text": "Mari jirkaaga marka aad maydhato kadib, si udgoonku kuula socdo.",
   "s": 23.737,
   "e": 27.295
  },
  {
   "id": "l8",
   "text": "Waxaad ka heli kartaa Falarosa Luxury, Surrey, BC, Kanada.",
   "s": 27.935,
   "e": 31.258
  },
  {
   "id": "l9",
   "text": "Nagala soo xiriir lambarka ku qoran bogga.",
   "s": 31.898,
   "e": 33.97
  },
  {
   "id": "l10",
   "text": "Rose Noir, Ahmed Al Maghribi. Hadda dalbo!",
   "s": 34.61,
   "e": 37.48
  }
 ],
